{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/contracts/validation-surfaces.schema.json",
  "title": "Affected-surface validation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "pathSemantics",
    "lanes",
    "protectedLevels",
    "evidenceLanes",
    "validators",
    "ciJobs",
    "surfaces",
    "profiles",
    "profileAliases"
  ],
  "properties": {
    "$schema": {
      "const": "./registry.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "pathSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "separator",
        "matching",
        "caseSensitive",
        "precedence"
      ],
      "properties": {
        "separator": {
          "const": "posix"
        },
        "matching": {
          "const": "exact-or-anchored-regex"
        },
        "caseSensitive": {
          "const": true
        },
        "precedence": {
          "const": "none"
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "affected",
          "staged",
          "all-files",
          "message/manual",
          "ci",
          "remote/live",
          "inventory"
        ]
      }
    },
    "protectedLevels": {
      "const": [
        "none",
        "review",
        "protected"
      ]
    },
    "evidenceLanes": {
      "const": [
        "repo-static",
        "ci",
        "remote/live"
      ]
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validator"
      }
    },
    "ciJobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ciJob"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quick",
        "staged",
        "full"
      ],
      "properties": {
        "quick": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "staged": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "full": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "profileAliases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ci"
      ],
      "properties": {
        "ci": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exact",
            "regex"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "FAIL",
            "DEFER",
            "SKIP"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "lanes",
        "optional",
        "fallback",
        "evidenceLane"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "boolean"
        },
        "fallback": {
          "$ref": "#/$defs/fallback"
        },
        "evidenceLane": {
          "type": "string"
        },
        "structuredResults": {
          "const": "platform-depth-v1"
        },
        "pathInput": {
          "const": "include-existing-markdown"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "reuse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "same-lane",
                "change-scoped"
              ]
            },
            "hosted": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "image",
                "platform",
                "python",
                "version",
                "inputs"
              ],
              "properties": {
                "image": {
                  "type": "string",
                  "const": "docker.io/library/python@sha256:c90be507635af19768837aa7eeb2f4ce89a74d62962a335497b9df8edfb7f19d"
                },
                "platform": {
                  "type": "string",
                  "const": "linux/amd64"
                },
                "python": {
                  "type": "string",
                  "const": "/usr/local/bin/python3"
                },
                "version": {
                  "type": "string",
                  "const": "3.12.14"
                },
                "inputs": {
                  "type": "string",
                  "const": "committed-tree-v1"
                }
              }
            }
          }
        },
        "coveredBy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ciJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "output",
        "evidenceLane"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "output": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "evidenceLane": {
          "type": "string"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "routes",
        "validators",
        "ciJobs",
        "protectedLevel",
        "fallback",
        "evidenceLane"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "validators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "ciJobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "protectedLevel": {
          "enum": [
            "none",
            "review",
            "protected"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/fallback"
        },
        "evidenceLane": {
          "type": "string"
        }
      }
    }
  }
}
