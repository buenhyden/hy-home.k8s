    {
      "id": "selected-style",
      "argv": [
        "python3",
        "scripts/validate-selected-style.py",
        "--root",
        ".",
        "--config",
        ".pre-commit-config.yaml",
        "--markdown-config",
        ".markdownlint-cli2.yaml",
        "--ruff-config",
        ".ruff.toml"
