  "surfaces": [
    {
      "id": "root-config",
      "routes": [
        {
          "kind": "exact",
          "value": ".cz.toml"
        },
        {
          "kind": "exact",
          "value": ".editorconfig"
        },
        {
          "kind": "exact",
          "value": ".env.example"
        },
        {
          "kind": "exact",
          "value": ".gitattributes"
        },
        {
          "kind": "exact",
          "value": ".gitignore"
        },
        {
          "kind": "exact",
          "value": ".gitleaks.toml"
        },
        {
          "kind": "exact",
          "value": ".gitmessage"
        },
        {
          "kind": "exact",
          "value": ".graphifyignore"
        },
        {
          "kind": "exact",
          "value": ".hadolint.yaml"
        },
        {
          "kind": "exact",
          "value": ".kube-linter.yaml"
        },
        {
          "kind": "exact",
          "value": ".markdownlint-cli2.yaml"
        },
        {
          "kind": "exact",
          "value": ".pre-commit-config.yaml"
