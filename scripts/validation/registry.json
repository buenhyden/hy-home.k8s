{
  "$schema": "./registry.schema.json",
  "schemaVersion": 4,
  "pathSemantics": {
    "separator": "posix",
    "matching": "exact-or-anchored-regex",
    "caseSensitive": true,
    "precedence": "none"
  },
  "lanes": [
    "affected",
    "staged",
    "message/manual",
    "remote/live",
    "inventory"
  ],
  "protectedLevels": [
    "none",
    "review",
    "protected"
  ],
  "evidenceLanes": [
    "repo-static",
    "ci",
    "remote/live"
  ],
  "validators": [
    {
      "id": "affected-surface-contract",
      "argv": [
        "python3",
        "scripts/validate-affected-surfaces.py",
        "--root",
        "."
      ],
      "lanes": [
        "affected",
        "staged"
      ],
      "optional": false,
      "fallback": {
        "status": "FAIL",
        "reason": "Affected-surface registry validation is required."
      },
      "evidenceLane": "repo-static"
    },
    {
      "id": "agent-governance",
      "argv": [
        "python3",
        "scripts/validate-agent-governance.py",
        "--root",
        "."
      ],
      "lanes": [
        "affected",
        "staged"
      ],
      "optional": false,
      "fallback": {
        "status": "FAIL",
        "reason": "Canonical agent registry, native adapter, and consumer validation is required."
      },
      "evidenceLane": "repo-static"
    },
    {
      "id": "archive-contract-tests",
