      "lanes": [
        "staged"
      ],
      "pathInput": "include-existing-files",
      "globalSelection": "staged-changed",
      "timeoutSeconds": 600,
      "optional": false,
      "fallback": {
        "status": "FAIL",
        "reason": "Selected staged file style validation is required."
