        "ci-python-contract",
        "repository-quality"
      ],
      "protectedLevel": "review",
      "fallback": {
        "status": "FAIL",
        "reason": "New root files require an explicit route."
      },
      "evidenceLane": "repo-static"
    },
    {
      "id": "provider-gateways",
      "routes": [
        {
          "kind": "exact",
          "value": "AGENTS.md"
        },
        {
          "kind": "exact",
          "value": "CLAUDE.md"
        }
