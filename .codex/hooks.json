{
  "description": "Pre-action guard for tracked repository writes.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/pre-tool-use.sh\" ; [ -f \"$hook\" ] || { echo \"[FAIL] HOOK-ADAPTER: the write guard adapter is unavailable\" >&2 ; exit 2 ; } ; exec bash \"$hook\"",
            "timeout": 30,
            "statusMessage": "Checking the repository write boundary"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/session-capture.sh\" ; [ -f \"$hook\" ] || exit 0 ; exec bash \"$hook\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/session-capture.sh\" ; [ -f \"$hook\" ] || exit 0 ; exec bash \"$hook\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/session-capture.sh\" ; [ -f \"$hook\" ] || exit 0 ; exec bash \"$hook\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/session-capture.sh\" ; [ -f \"$hook\" ] || exit 0 ; exec bash \"$hook\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/session-capture.sh\" ; [ -f \"$hook\" ] || exit 0 ; exec bash \"$hook\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
