{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/docs/99.templates/contracts/frontmatter.schema.json",
  "title": "Authored document frontmatter",
  "description": "Validates the YAML frontmatter mapping of one authored document. Per-profile required, allowed, and ordered key sets stay in registry.json; this schema owns the shape and value grammar of each key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "type",
    "status",
    "owner",
    "updated"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-/][a-z0-9]+)*$"
    },
    "layer": {
      "type": "string",
      "pattern": "^[0-9]{2}\\.[a-z][a-z0-9-]*$"
    },
    "status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "$ref": "#/$defs/isoDate"
    },
    "artifact_id": {
      "$ref": "#/$defs/artifactId"
    },
    "original_artifact_id": {
      "$ref": "#/$defs/artifactId"
    },
    "original_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-/][a-z0-9]+)*$"
    },
    "original_path": {
      "$ref": "#/$defs/repoRelativePath"
    },
    "archived_on": {
      "$ref": "#/$defs/isoDate"
    },
    "archive_reason": {
      "type": "string",
      "minLength": 1
    },
    "replacement": {
      "oneOf": [
        {
          "$ref": "#/$defs/repoRelativePath"
        },
        {
          "const": "none"
        }
      ]
    },
    "source_commit": {
      "$ref": "#/$defs/gitOid"
    },
    "source_blob": {
      "$ref": "#/$defs/gitOid"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repoRelativePath": {
      "type": "string",
      "pattern": "^[^/][^\\\\]*$"
    },
    "artifactId": {
      "description": "Every identity form the current corpus admits.",
      "$ref": "#/$defs/terminalArtifactId"
    },
    "terminalArtifactId": {
      "type": "string",
      "pattern": "^(?:(?:REQ|AD|ADR|SPEC|GDE|POL|RUN|MIG)-[0-9]{4}|DATA-MODEL-[0-9]{4}|SPEC-[0-9]{4}-(?:PLAN|TSK)-[0-9]{4}|(?:AUD|RES|DATA)-[0-9]{4}-m[0-9]{4}|inc-[0-9]{4}-[0-9]{4}(?:-PM)?|tomb-(?:PRD|AD|ADR|SPEC|GDE|RUN)-[0-9]{4})$"
    },
    "requirementMemberId": {
      "type": "string",
      "pattern": "^REQ-[0-9]{4}-(?:FR|NFR|IF)-[0-9]{4}$"
    }
  }
}
