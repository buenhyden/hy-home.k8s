{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/docs/99.templates/contracts/frontmatter.schema.json",
  "title": "Authored document frontmatter",
  "description": "Validates the YAML frontmatter mapping of one authored document. Per-profile required, allowed, and ordered key sets stay in registry.json; this schema owns the shape and value grammar of each key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "version",
    "type",
    "owner",
    "updated"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-/][a-z0-9]+)*$"
    },
    "layer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "$ref": "#/$defs/isoDate"
    },
    "artifact_id": {
      "$ref": "#/$defs/artifactId"
    },
    "parent_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/terminalArtifactId"
      }
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "authorization_ref",
        "criteria_disposition"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1
        },
        "criteria_disposition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supersedes": {
      "$ref": "#/$defs/artifactIdReference"
    },
    "superseded_by": {
      "$ref": "#/$defs/artifactIdReference"
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "artifactId": {
      "description": "Every identity form the current corpus admits.",
      "$ref": "#/$defs/terminalArtifactId"
    },
    "terminalArtifactId": {
      "type": "string",
      "pattern": "^(?:(?:REQ|AD|ADR|SPEC|GDE|POL|RUN|AUD|RES|DATA)-[0-9]{4}|SPEC-[0-9]{4}-(?:PLAN|TSK)-[0-9]{4}|(?:AUD|RES|DATA)-[0-9]{4}-m[0-9]{4}|inc-[0-9]{4}-[0-9]{4}(?:-PM)?)$"
    },
    "requirementMemberId": {
      "type": "string",
      "pattern": "^REQ-[0-9]{4}-(?:FR|NFR|IF)-[0-9]{4}$"
    },
    "artifactIdReference": {
      "description": "One artifact identity, or an ordered set of them.",
      "oneOf": [
        {
          "$ref": "#/$defs/terminalArtifactId"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/terminalArtifactId"
          }
        }
      ]
    }
  }
}
