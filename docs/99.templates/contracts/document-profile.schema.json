{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/docs/99.templates/contracts/document-profile.schema.json",
  "title": "Document profile registry",
  "description": "Validates the single Stage 99 path, profile, frontmatter, section, lifecycle, relationship, and template-binding authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schema_version",
    "profiles",
    "lifecycle_domains"
  ],
  "properties": {
    "$schema": {
      "const": "./contracts/document-profile.schema.json"
    },
    "$id": {
      "const": "https://hy-home.k8s/docs/99.templates/registry.json"
    },
    "schema_version": {
      "const": 10
    },
    "shared_contract": {
      "description": "Identifies reviewed common input and the local adapter; structural validity does not authenticate approval or adoption.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "version",
        "stage",
        "owner",
        "source",
        "source_revision",
        "content_digest",
        "approval_ref",
        "local_adapter",
        "extensions"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9]+(?:\\.[a-z0-9]+)*)?$"
        },
        "stage": {
          "enum": [
            "candidate",
            "approved",
            "adopted"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "local_adapter": {
          "type": "string",
          "pattern": "\\S"
        },
        "extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shared_extension"
          }
        },
        "approved_by": {
          "type": "string",
          "pattern": "\\S"
        },
        "approved_at": {
          "type": "string",
          "pattern": "^(?:unverified|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01]))$"
        },
        "effective_from": {
          "type": "string",
          "pattern": "^(?:unverified|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01]))$"
        },
        "scope": {
          "type": "string",
          "pattern": "\\S"
        },
        "migration": {
          "type": "string",
          "pattern": "\\S"
        },
        "rollback": {
          "type": "string",
          "pattern": "\\S"
        },
        "consumer_version": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "approved",
                  "adopted"
                ]
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "required": [
              "approved_by",
              "approved_at",
              "effective_from"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "adopted"
              }
            }
          },
          "then": {
            "properties": {
              "source_revision": {
                "type": "string"
              },
              "approval_ref": {
                "type": "string"
              },
              "version": {
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "approved_by": {
                    "const": "unverified"
                  }
                },
                "required": [
                  "approved_by"
                ]
              },
              {
                "properties": {
                  "approved_at": {
                    "const": "unverified"
                  }
                },
                "required": [
                  "approved_at"
                ]
              },
              {
                "properties": {
                  "effective_from": {
                    "const": "unverified"
                  }
                },
                "required": [
                  "effective_from"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "approval_ref": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "mode",
          "path_pattern",
          "artifact_id_pattern",
          "template_source",
          "frontmatter",
          "sections",
          "lifecycle",
          "relationships",
          "placeholder_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:common|governance|sdlc|operation|reference|evaluation)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "family": {
            "enum": [
              "common",
              "governance",
              "sdlc",
              "operation",
              "reference",
              "evaluation"
            ]
          },
          "mode": {
            "enum": [
              "authored",
              "router",
              "template",
              "native",
              "non-target"
            ]
          },
          "document_role": {
            "enum": [
              "requirement",
              "architecture",
              "adr",
              "spec",
              "plan",
              "task",
              "guide",
              "runbook",
              "policy",
              "incident",
              "postmortem",
              "root-readme",
              "stage-readme",
              "service-readme",
              "agents",
              "skill"
            ]
          },
          "path_pattern": {
            "type": "string",
            "pattern": "^\\^.*\\$$"
          },
          "artifact_id_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "template_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "frontmatter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "required",
              "optional",
              "forbidden",
              "order",
              "constants"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "required",
                  "absent"
                ]
              },
              "required": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "optional": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "forbidden": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "order": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "constants": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "sections": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "optional",
              "forbidden"
            ],
            "properties": {
              "required": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "optional": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "forbidden": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "substantive_body": {
                "type": "boolean"
              },
              "ordered": {
                "type": "boolean"
              }
            }
          },
          "lifecycle": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "status_domain"
            ],
            "properties": {
              "status_domain": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "relationships": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_profile_ids",
              "body_contract"
            ],
            "properties": {
              "source_profile_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "body_contract": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "section",
                  "table_heading",
                  "enforced_statuses",
                  "required_columns",
                  "identifier_columns",
                  "source_link_column",
                  "target_link_column",
                  "allowed_source_profile_ids",
                  "allowed_target_profile_ids",
                  "allow_explicit_exclusion"
                ],
                "properties": {
                  "task_execution": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "single_status_marker",
                      "result_states",
                      "summary_rule",
                      "acceptance_states",
                      "criterion_acceptance_section"
                    ],
                    "properties": {
                      "single_status_marker": {
                        "const": "frontmatter"
                      },
                      "result_states": {
                        "type": "object"
                      },
                      "acceptance_states": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "uniqueItems": true
                      },
                      "summary_rule": {
                        "const": "task-items-v2"
                      },
                      "evidence_section": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_columns": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "evidence_result_states": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "criterion_acceptance_section": {
                        "type": "string",
                        "minLength": 1
                      },
                      "criterion_acceptance_columns": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "table_heading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "enforced_statuses": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "required_columns": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "identifier_columns": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "column",
                        "kind"
                      ],
                      "properties": {
                        "column": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "enum": [
                            "requirement",
                            "criterion",
                            "work-item"
                          ]
                        }
                      }
                    }
                  },
                  "source_link_column": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "target_link_column": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "allowed_source_profile_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "allowed_target_profile_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "allow_explicit_exclusion": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "placeholder_policy": {
            "enum": [
              "forbidden",
              "template-only"
            ]
          },
          "template_definition": {
            "$ref": "#/$defs/template_definition"
          }
        }
      }
    },
    "lifecycle_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "profile_ids",
          "states",
          "transitions"
        ],
        "properties": {
          "family": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "profile_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "initial_states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "states": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "enum": [
                "mutable",
                "current",
                "terminal"
              ]
            }
          },
          "transitions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "readme_navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholders",
        "forbidden_index_columns",
        "max_deep_links_per_child",
        "profiles",
        "pending_paths",
        "exempt_paths"
      ],
      "properties": {
        "placeholders": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_index_columns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_deep_links_per_child": {
          "type": "integer",
          "minimum": 1
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "complete"
            ],
            "properties": {
              "section": {
                "type": "string",
                "minLength": 1
              },
              "complete": {
                "type": "boolean"
              }
            }
          }
        },
        "pending_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "(^|/)README\\.md$"
          }
        },
        "exempt_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "(^|/)README\\.md$"
          }
        },
        "index_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optional_index_columns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "document_language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "english_only_roots",
        "korean_allowed_markdown_roots",
        "english_only_suffixes",
        "korean_first_profiles",
        "english_sections",
        "min_latin_words",
        "pending_paths"
      ],
      "properties": {
        "english_only_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/].*/$"
          }
        },
        "korean_allowed_markdown_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "const": ".agents/"
          }
        },
        "english_only_suffixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9]+$"
          }
        },
        "korean_first_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "english_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "min_latin_words": {
          "type": "integer",
          "minimum": 1
        },
        "pending_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\.md$"
          }
        }
      }
    },
    "common_forms": {
      "description": "The opt-in section tree per document role; a role has a form only once it is listed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "version",
        "forms"
      ],
      "properties": {
        "contract_id": {
          "const": "COMMON-DOC-FORM-1"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "forms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/common_form"
          }
        }
      }
    }
  },
  "$defs": {
    "heading_lists": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional",
        "forbidden"
      ],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "substantive_body": {
          "type": "boolean"
        },
        "ordered": {
          "type": "boolean"
        }
      }
    },
    "section": {
      "description": "One COMMON-DOC-FORM-1 section; link_only is the one local field.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "level",
        "parent_id",
        "title",
        "order",
        "requiredness",
        "condition",
        "content",
        "required_content",
        "prohibited_content",
        "empty_policy",
        "validation_ids",
        "children"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            2,
            3
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "requiredness": {
          "enum": [
            "required",
            "conditional",
            "optional"
          ]
        },
        "condition": {
          "type": "string",
          "pattern": "\\S"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "required_content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited_content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "empty_policy": {
          "enum": [
            "explain_none_or_not_applicable",
            "omit_when_condition_false"
          ]
        },
        "validation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "link_only": {
          "type": "boolean",
          "default": false
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "form_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "condition",
        "owner",
        "verification",
        "review",
        "removal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "local_h3",
            "retained_form"
          ]
        },
        "condition": {
          "type": "string",
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "pattern": "\\S"
        },
        "verification": {
          "type": "string",
          "pattern": "\\S"
        },
        "review": {
          "type": "string",
          "pattern": "\\S"
        },
        "removal": {
          "type": "string",
          "pattern": "\\S"
        },
        "parent_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retained_sections": {
          "$ref": "#/$defs/heading_lists"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "local_h3"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "parent_id",
              "title"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "statuses"
                  ]
                },
                {
                  "required": [
                    "retained_sections"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "retained_form"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "statuses",
              "retained_sections"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "parent_id"
                  ]
                },
                {
                  "required": [
                    "title"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "common_form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_id",
        "title",
        "h1",
        "language_rule",
        "extension_policy",
        "sections",
        "extensions"
      ],
      "properties": {
        "form_id": {
          "enum": [
            "requirement",
            "architecture",
            "adr",
            "spec",
            "plan",
            "task",
            "guide",
            "runbook",
            "policy",
            "incident",
            "postmortem",
            "root-readme",
            "stage-readme",
            "service-readme",
            "agents",
            "skill"
          ]
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "h1": {
          "type": "string",
          "pattern": "\\S"
        },
        "language_rule": {
          "type": "string",
          "pattern": "\\S"
        },
        "extension_policy": {
          "type": "string",
          "pattern": "\\S"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/form_extension"
          }
        }
      }
    },
    "template_definition": {
      "description": "The TemplateDefinition fields a registry stores; role, version, headings and the rest are derived.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "responsibility",
        "non_goals",
        "policy_refs",
        "vocabulary_refs",
        "applicability",
        "tables",
        "consumer_paths",
        "validation",
        "migration"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "pattern": "\\S"
        },
        "responsibility": {
          "type": "string",
          "pattern": "\\S"
        },
        "non_goals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applicability": {
          "type": "string",
          "pattern": "\\S"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/template_table"
          }
        },
        "consumer_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "positive",
            "negative",
            "regression"
          ],
          "properties": {
            "positive": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "negative": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "regression": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "meaning_map",
            "retained_history",
            "rollback"
          ],
          "properties": {
            "meaning_map": {
              "type": "string",
              "pattern": "\\S"
            },
            "retained_history": {
              "type": "string",
              "pattern": "\\S"
            },
            "rollback": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "template_table": {
      "description": "One table a template carries: its section, ordered columns, minimum data rows and row identity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "section",
        "columns",
        "minimum_rows",
        "row_identity"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "meaning",
              "data_type",
              "required"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "data_type": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "minimum_rows": {
          "type": "integer",
          "minimum": 0
        },
        "row_identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shared_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "condition",
        "owner",
        "verification",
        "review",
        "removal"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "condition": {
          "type": "string",
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "pattern": "\\S"
        },
        "verification": {
          "type": "string",
          "pattern": "\\S"
        },
        "review": {
          "type": "string",
          "pattern": "\\S"
        },
        "removal": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  }
}
