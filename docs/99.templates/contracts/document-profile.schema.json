{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/docs/99.templates/contracts/document-profile.schema.json",
  "title": "Document profile registry",
  "description": "Validates the single Stage 99 path, profile, frontmatter, section, lifecycle, relationship, and template-binding authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schema_version",
    "profiles",
    "lifecycle_domains"
  ],
  "properties": {
    "$schema": {
      "const": "./contracts/document-profile.schema.json"
    },
    "$id": {
      "const": "https://hy-home.k8s/docs/99.templates/registry.json"
    },
    "schema_version": {
      "const": 10
    },
    "shared_contract": {
      "description": "Identifies reviewed common input and the local adapter; structural validity does not authenticate approval or adoption.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "version",
        "stage",
        "owner",
        "source",
        "source_revision",
        "content_digest",
        "approval_ref",
        "local_adapter",
        "extensions"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9]+(?:\\.[a-z0-9]+)*)?$"
        },
        "stage": {
          "enum": [
            "candidate",
            "adopted"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "local_adapter": {
          "type": "string",
          "pattern": "\\S"
        },
        "extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "adopted"
              }
            }
          },
          "then": {
            "properties": {
              "source_revision": {
                "type": "string"
              },
              "approval_ref": {
                "type": "string"
              },
              "version": {
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          }
        }
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "mode",
          "path_pattern",
          "artifact_id_pattern",
          "template_source",
          "frontmatter",
          "sections",
          "lifecycle",
          "relationships",
          "placeholder_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:common|governance|sdlc|operation|reference|evaluation)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "family": {
            "enum": [
              "common",
              "governance",
              "sdlc",
              "operation",
              "reference",
              "evaluation"
            ]
          },
          "mode": {
            "enum": [
              "authored",
              "router",
              "template",
              "evidence",
              "native",
              "generated",
              "non-target"
            ]
          },
          "path_pattern": {
            "type": "string",
            "pattern": "^\\^.*\\$$"
          },
          "artifact_id_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "template_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "frontmatter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "required",
              "optional",
              "forbidden",
              "order",
              "constants"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "required",
                  "absent"
                ]
              },
              "required": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "optional": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "forbidden": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "order": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "constants": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "sections": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "optional",
              "forbidden"
            ],
            "properties": {
              "required": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "optional": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "forbidden": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "substantive_body": {
                "type": "boolean"
              },
              "ordered": {
                "type": "boolean"
              }
            }
          },
          "lifecycle": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "status_domain"
            ],
            "properties": {
              "status_domain": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "relationships": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_profile_ids",
              "body_contract"
            ],
            "properties": {
              "source_profile_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "body_contract": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "section",
                  "table_heading",
                  "enforced_statuses",
                  "required_columns",
                  "identifier_columns",
                  "source_link_column",
                  "target_link_column",
                  "allowed_source_profile_ids",
                  "allowed_target_profile_ids",
                  "reciprocal_evidence",
                  "allow_explicit_exclusion"
                ],
                "properties": {
                  "task_execution": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "single_status_marker",
                      "result_states",
                      "summary_rule",
                      "acceptance_states",
                      "criterion_acceptance_section"
                    ],
                    "properties": {
                      "single_status_marker": {
                        "const": "frontmatter"
                      },
                      "result_states": {
                        "type": "object"
                      },
                      "acceptance_states": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "uniqueItems": true
                      },
                      "summary_rule": {
                        "const": "task-items-v2"
                      },
                      "evidence_section": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_columns": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "evidence_result_states": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "criterion_acceptance_section": {
                        "type": "string",
                        "minLength": 1
                      },
                      "criterion_acceptance_columns": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "table_heading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "enforced_statuses": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "required_columns": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "identifier_columns": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "column",
                        "kind"
                      ],
                      "properties": {
                        "column": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "enum": [
                            "requirement",
                            "criterion",
                            "work-item"
                          ]
                        }
                      }
                    }
                  },
                  "source_link_column": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "target_link_column": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "allowed_source_profile_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "allowed_target_profile_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "reciprocal_evidence": {
                    "type": "boolean"
                  },
                  "allow_explicit_exclusion": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "placeholder_policy": {
            "enum": [
              "forbidden",
              "template-only"
            ]
          }
        }
      }
    },
    "lifecycle_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "profile_ids",
          "states",
          "transitions"
        ],
        "properties": {
          "family": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "profile_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "initial_states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "states": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "enum": [
                "mutable",
                "current",
                "terminal"
              ]
            }
          },
          "transitions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "readme_navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholders",
        "forbidden_index_columns",
        "max_deep_links_per_child",
        "profiles",
        "pending_paths",
        "exempt_paths"
      ],
      "properties": {
        "placeholders": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_index_columns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_deep_links_per_child": {
          "type": "integer",
          "minimum": 1
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "complete"
            ],
            "properties": {
              "section": {
                "type": "string",
                "minLength": 1
              },
              "complete": {
                "type": "boolean"
              }
            }
          }
        },
        "pending_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "(^|/)README\\.md$"
          }
        },
        "exempt_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "(^|/)README\\.md$"
          }
        },
        "index_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optional_index_columns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "document_language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "english_only_roots",
        "korean_allowed_markdown_roots",
        "english_only_suffixes",
        "korean_first_profiles",
        "english_sections",
        "min_latin_words",
        "pending_paths"
      ],
      "properties": {
        "english_only_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/].*/$"
          }
        },
        "korean_allowed_markdown_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "const": ".agents/"
          }
        },
        "english_only_suffixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9]+$"
          }
        },
        "korean_first_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "english_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "min_latin_words": {
          "type": "integer",
          "minimum": 1
        },
        "pending_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\.md$"
          }
        }
      }
    }
  }
}
