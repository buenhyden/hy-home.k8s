{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/docs/99.templates/contracts/document-profile.schema.json",
  "title": "Document profile registry",
  "description": "Validates docs/99.templates/registry.json. The registry owns path, profile, required sections, lifecycle, and identity rules and nothing else. Archive inventories, transition baselines, governance owners, and Stage 90 pack inventories are owned elsewhere and are rejected here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schemaVersion",
    "profiles",
    "programLineage"
  ],
  "properties": {
    "$schema": {
      "description": "Relative pointer to this schema, which validates the registry.",
      "const": "./contracts/document-profile.schema.json"
    },
    "$id": {
      "const": "https://hy-home.k8s/docs/99.templates/registry.json"
    },
    "schemaVersion": {
      "const": 8
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "programLineage": {
      "$ref": "#/$defs/programLineage"
    },
    "standaloneExecutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/standaloneExecution"
      }
    }
  },
  "$defs": {
    "appendContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentProfileId",
        "parentH2",
        "entryHeadingLevel",
        "sectionHeadingLevel",
        "requiredSections"
      ],
      "properties": {
        "parentProfileId": {
          "type": "string",
          "minLength": 1
        },
        "parentH2": {
          "type": "string",
          "minLength": 1
        },
        "entryHeadingLevel": {
          "const": 3
        },
        "sectionHeadingLevel": {
          "const": 4
        },
        "requiredSections": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "bodyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "tableHeading",
        "enforcedStatuses",
        "requiredColumns",
        "identifierColumns",
        "sourceLinkColumn",
        "targetLinkColumn",
        "allowedSourceProfileIds",
        "allowedTargetProfileIds",
        "reciprocalEvidence",
        "allowExplicitExclusion"
      ],
      "properties": {
        "section": {
          "type": "string",
          "minLength": 1
        },
        "tableHeading": {
          "type": "string",
          "minLength": 1
        },
        "enforcedStatuses": {
          "$ref": "#/$defs/stringArray"
        },
        "requiredColumns": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "identifierColumns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifierColumn"
          }
        },
        "sourceLinkColumn": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "targetLinkColumn": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "allowedSourceProfileIds": {
          "$ref": "#/$defs/stringArray"
        },
        "allowedTargetProfileIds": {
          "$ref": "#/$defs/stringArray"
        },
        "reciprocalEvidence": {
          "type": "boolean"
        },
        "allowExplicitExclusion": {
          "type": "boolean"
        }
      }
    },
    "frontmatter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "required",
        "allowed",
        "order"
      ],
      "properties": {
        "mode": {
          "enum": [
            "required",
            "forbidden",
            "not-applicable"
          ]
        },
        "required": {
          "$ref": "#/$defs/stringArray"
        },
        "allowed": {
          "$ref": "#/$defs/stringArray"
        },
        "order": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "headings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "allowed"
      ],
      "properties": {
        "required": {
          "$ref": "#/$defs/stringArray"
        },
        "allowed": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "identifierColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "kind"
      ],
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "requirement",
            "criterion",
            "work-item"
          ]
        }
      }
    },
    "lifecycle": {
      "description": "Status domain and append rule for this profile.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statusDomain",
        "appendContract"
      ],
      "properties": {
        "statusDomain": {
          "$ref": "#/$defs/stringArray"
        },
        "appendContract": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/appendContract"
            }
          ]
        }
      }
    },
    "lifecycleDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "profileIds", "states", "transitions"],
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "profileIds": {
          "$ref": "#/$defs/stringArray"
        },
        "states": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "enum": ["mutable", "current", "terminal"]
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "string", "minLength": 1},
              {"type": "string", "minLength": 1}
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "nonEmptyStringArray": {
      "allOf": [
        {
          "$ref": "#/$defs/stringArray"
        },
        {
          "minItems": 1
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "mode",
        "pathPattern",
        "template",
        "requiredFrontmatter",
        "requiredSections",
        "relationships",
        "placeholderPolicy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "sdlc",
            "common",
            "governance",
            "readme",
            "exception"
          ]
        },
        "mode": {
          "enum": [
            "authored",
            "template",
            "frontmatter-free",
            "classification-only",
            "generated",
            "non-target"
          ]
        },
        "pathPattern": {
          "description": "One anchored regular expression owning every path this profile classifies. Profiles that previously listed several exact routes carry them as a single alternation.",
          "type": "string",
          "pattern": "^\\^.*\\$$"
        },
        "artifactIdPattern": {
          "description": "Anchored pattern the document's artifact_id must match, or null when the profile has no outer identity.",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "requiredFrontmatter": {
          "$ref": "#/$defs/frontmatter"
        },
        "requiredSections": {
          "$ref": "#/$defs/headings"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "relationships": {
          "$ref": "#/$defs/relationships"
        },
        "placeholderPolicy": {
          "enum": [
            "forbidden",
            "template-only"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"class": {"const": "readme"}},
            "required": ["class"]
          },
          "then": {
            "properties": {
              "artifactIdPattern": false,
              "lifecycle": false
            }
          },
          "else": {
            "required": ["artifactIdPattern", "lifecycle"]
          }
        }
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prd",
        "ad",
        "tranches",
        "followUps"
      ],
      "properties": {
        "prd": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "ad": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "tranches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/programRelation"
          }
        },
        "followUps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/programFollowUp"
          }
        }
      }
    },
    "programFollowUp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "order",
        "state",
        "reason",
        "decision",
        "evidenceMode"
      ],
      "properties": {
        "spec": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "draft",
            "active",
            "done",
            "archived"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "evidenceMode": {
          "enum": [
            "reciprocal-body",
            "successor-record"
          ]
        }
      }
    },
    "programLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transitionLifecycleContracts",
        "lifecycleDomains",
        "programs"
      ],
      "properties": {
        "transitionLifecycleContracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/lifecycleContract"}
        },
        "lifecycleDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lifecycleDomain"
          }
        },
        "programs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/program"
          }
        }
      }
    },
    "lifecycleEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "predicateId"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "predicateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "lifecycleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profileIds", "terminalStates", "edges"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "profileIds": {"$ref": "#/$defs/nonEmptyStringArray"},
        "terminalStates": {"$ref": "#/$defs/stringArray"},
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/lifecycleEdge"}
        }
      }
    },
    "programRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "order",
        "state",
        "reason",
        "decision"
      ],
      "properties": {
        "spec": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "draft",
            "active",
            "done",
            "archived"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        }
      }
    },
    "relationships": {
      "description": "Upstream profile sources and the traceability body contract.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceProfileIds",
        "bodyContract"
      ],
      "properties": {
        "sourceProfileIds": {
          "$ref": "#/$defs/stringArray"
        },
        "bodyContract": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bodyContract"
            }
          ]
        }
      }
    },
    "standaloneExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "plan",
        "task",
        "state",
        "reason",
        "decision",
        "approvalMode"
      ],
      "properties": {
        "spec": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "plan": {
          "type": "string",
          "pattern": "^docs/03\\.specs/[0-9]{4}-[A-Za-z0-9][A-Za-z0-9._-]*/plan\\.md$"
        },
        "task": {
          "type": "string",
          "pattern": "^docs/03\\.specs/[0-9]{4}-[A-Za-z0-9][A-Za-z0-9._-]*/(?:tasks\\.md|tasks/tsk-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*\\.md)$"
        },
        "state": {
          "enum": [
            "active",
            "done",
            "archived"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "approvalMode": {
          "const": "spec-body-record"
        }
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
