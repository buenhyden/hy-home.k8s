{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/docs/99.templates/contracts/document-profile.schema.json",
  "title": "Document profile registry",
  "description": "Validates the single Stage 99 path, profile, frontmatter, section, lifecycle, relationship, and template-binding authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schema_version",
    "profiles",
    "lifecycle_domains"
  ],
  "properties": {
    "$schema": {
      "const": "./contracts/document-profile.schema.json"
    },
    "$id": {
      "const": "https://hy-home.k8s/docs/99.templates/registry.json"
    },
    "schema_version": {
      "const": 9
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "mode",
          "path_pattern",
          "artifact_id_pattern",
          "template_source",
          "frontmatter",
          "sections",
          "lifecycle",
          "relationships",
          "placeholder_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:common|governance|sdlc|operation|reference|archive)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "family": {
            "enum": [
              "common",
              "governance",
              "sdlc",
              "operation",
              "reference",
              "archive"
            ]
          },
          "mode": {
            "enum": [
              "authored",
              "router",
              "template",
              "evidence",
              "native",
              "generated",
              "non-target"
            ]
          },
          "path_pattern": {
            "type": "string",
            "pattern": "^\\^.*\\$$"
          },
          "artifact_id_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "template_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "frontmatter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "required",
              "optional",
              "forbidden",
              "order",
              "constants"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "required",
                  "absent"
                ]
              },
              "required": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "optional": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "forbidden": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "order": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "constants": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "sections": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "optional",
              "forbidden"
            ],
            "properties": {
              "required": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "optional": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "forbidden": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "lifecycle": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "status_domain"
            ],
            "properties": {
              "status_domain": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "relationships": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_profile_ids",
              "body_contract"
            ],
            "properties": {
              "source_profile_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "body_contract": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "section",
                  "table_heading",
                  "enforced_statuses",
                  "required_columns",
                  "identifier_columns",
                  "source_link_column",
                  "target_link_column",
                  "allowed_source_profile_ids",
                  "allowed_target_profile_ids",
                  "reciprocal_evidence",
                  "allow_explicit_exclusion"
                ],
                "properties": {
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "table_heading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "enforced_statuses": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "required_columns": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "identifier_columns": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "column",
                        "kind"
                      ],
                      "properties": {
                        "column": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "enum": [
                            "requirement",
                            "criterion",
                            "work-item"
                          ]
                        }
                      }
                    }
                  },
                  "source_link_column": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "target_link_column": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "allowed_source_profile_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "allowed_target_profile_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "reciprocal_evidence": {
                    "type": "boolean"
                  },
                  "allow_explicit_exclusion": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "placeholder_policy": {
            "enum": [
              "forbidden",
              "template-only"
            ]
          }
        }
      }
    },
    "lifecycle_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "profile_ids",
          "states",
          "transitions"
        ],
        "properties": {
          "family": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "profile_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "states": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "enum": [
                "mutable",
                "current",
                "terminal"
              ]
            }
          },
          "transitions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "retention_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "names",
          "admitted_states"
        ],
        "properties": {
          "class": {
            "enum": [
              "completed",
              "superseded",
              "retired",
              "resolved"
            ]
          },
          "names": {
            "enum": [
              "promotion",
              "successor",
              "reason",
              "corrective-owner"
            ]
          },
          "admitted_states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "retention_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "root_pattern",
          "anchor",
          "required_members"
        ],
        "properties": {
          "unit": {
            "enum": [
              "spec-package",
              "incident-bundle"
            ]
          },
          "root_pattern": {
            "type": "string",
            "minLength": 2
          },
          "anchor": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*\\.md$"
          },
          "required_members": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*\\.md$"
            }
          },
          "member_admitted_states": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*\\.md$"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "retention_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "profile_id_pattern",
          "classes"
        ],
        "properties": {
          "mode": {
            "enum": [
              "move-frozen-body",
              "sealed-record",
              "retain-in-place",
              "git-history-only"
            ]
          },
          "profile_id_pattern": {
            "type": "string",
            "minLength": 2
          },
          "classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "completed",
                "superseded",
                "retired",
                "resolved"
              ]
            }
          }
        }
      }
    },
    "archive_citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "default",
        "rules"
      ],
      "properties": {
        "index": {
          "const": "docs/98.archive/README.md"
        },
        "default": {
          "const": "reject"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "decision"
            ],
            "properties": {
              "source": {
                "enum": [
                  "archive",
                  "any",
                  "profiles"
                ]
              },
              "source_profile_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "target": {
                "enum": [
                  "any",
                  "index",
                  "route-record",
                  "sealed-record",
                  "retained-body"
                ]
              },
              "target_classes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "completed",
                    "superseded",
                    "retired",
                    "resolved"
                  ]
                },
                "minItems": 1
              },
              "decision": {
                "enum": [
                  "admit",
                  "reject"
                ]
              },
              "target_assessments": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "unreviewed",
                    "usable",
                    "superseded",
                    "withdrawn",
                    "invalidated"
                  ]
                }
              },
              "target_availabilities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "retained",
                    "git-history-only",
                    "purged"
                  ]
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source": {
                      "const": "profiles"
                    }
                  }
                },
                "then": {
                  "required": [
                    "source_profile_ids"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "source_profile_ids"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "target": {
                      "const": "retained-body"
                    }
                  }
                },
                "then": {
                  "required": [
                    "target_classes"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "target_classes"
                    ]
                  }
                }
              },
              {
                "if": {
                  "anyOf": [
                    {
                      "required": [
                        "target_assessments"
                      ]
                    },
                    {
                      "required": [
                        "target_availabilities"
                      ]
                    }
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "const": "retained-body"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "archive_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "heading",
        "columns",
        "assessments",
        "availabilities",
        "default_assessment",
        "default_availability",
        "owner_required_assessments",
        "reserved_availabilities",
        "removed_availabilities",
        "decision_profile_ids",
        "default_branch"
      ],
      "properties": {
        "index": {
          "const": "docs/98.archive/README.md"
        },
        "heading": {
          "const": "Retention Assessment"
        },
        "columns": {
          "const": [
            "Disposition Record",
            "Assessment",
            "Availability",
            "Current Owner",
            "Decision",
            "Assessed",
            "Hold"
          ]
        },
        "assessments": {
          "const": [
            "unreviewed",
            "usable",
            "superseded",
            "withdrawn",
            "invalidated"
          ]
        },
        "availabilities": {
          "const": [
            "retained",
            "git-history-only",
            "purged"
          ]
        },
        "default_assessment": {
          "enum": [
            "unreviewed",
            "usable",
            "superseded",
            "withdrawn",
            "invalidated"
          ]
        },
        "default_availability": {
          "enum": [
            "retained",
            "git-history-only",
            "purged"
          ]
        },
        "owner_required_assessments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "unreviewed",
              "usable",
              "superseded",
              "withdrawn",
              "invalidated"
            ]
          }
        },
        "reserved_availabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "retained",
              "git-history-only",
              "purged"
            ]
          }
        },
        "removed_availabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "retained",
              "git-history-only",
              "purged"
            ]
          }
        },
        "decision_profile_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "default_branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        }
      }
    },
    "legacy_rebased_retained_paths": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^docs/[^\\s]+\\.md$"
      }
    },
    "readme_navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholders",
        "forbidden_index_columns",
        "max_deep_links_per_child",
        "profiles",
        "pending_paths"
      ],
      "properties": {
        "placeholders": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_index_columns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_deep_links_per_child": {
          "type": "integer",
          "minimum": 1
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "complete"
            ],
            "properties": {
              "section": {
                "type": "string",
                "minLength": 1
              },
              "complete": {
                "type": "boolean"
              }
            }
          }
        },
        "pending_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "(^|/)README\\.md$"
          }
        }
      }
    }
  }
}
