{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/docs/99.templates/contracts/document-profile.schema.json",
  "title": "Document profile registry",
  "description": "Validates the single Stage 99 path, profile, frontmatter, section, lifecycle, relationship, and template-binding authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "$id",
    "schema_version",
    "profiles",
    "lifecycle_domains"
  ],
  "properties": {
    "$schema": {
      "const": "./contracts/document-profile.schema.json"
    },
    "$id": {
      "const": "https://hy-home.k8s/docs/99.templates/registry.json"
    },
    "schema_version": {
      "const": 9
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "mode",
          "path_pattern",
          "artifact_id_pattern",
          "template_source",
          "frontmatter",
          "sections",
          "lifecycle",
          "relationships",
          "placeholder_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:common|governance|sdlc|operation|reference|archive)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "family": {
            "enum": [
              "common",
              "governance",
              "sdlc",
              "operation",
              "reference",
              "archive"
            ]
          },
          "mode": {
            "enum": [
              "authored",
              "router",
              "template",
              "evidence",
              "native",
              "generated",
              "non-target"
            ]
          },
          "path_pattern": {
            "type": "string",
            "pattern": "^\\^.*\\$$"
          },
          "artifact_id_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "template_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "frontmatter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "required",
              "optional",
              "forbidden",
              "order",
              "constants"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "required",
                  "absent"
                ]
              },
              "required": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "optional": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "forbidden": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "order": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "constants": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "sections": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "optional",
              "forbidden"
            ],
            "properties": {
              "required": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "optional": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "forbidden": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "lifecycle": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "status_domain"
            ],
            "properties": {
              "status_domain": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "relationships": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_profile_ids",
              "body_contract"
            ],
            "properties": {
              "source_profile_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "body_contract": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "section",
                  "table_heading",
                  "enforced_statuses",
                  "required_columns",
                  "identifier_columns",
                  "source_link_column",
                  "target_link_column",
                  "allowed_source_profile_ids",
                  "allowed_target_profile_ids",
                  "reciprocal_evidence",
                  "allow_explicit_exclusion"
                ],
                "properties": {
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "table_heading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "enforced_statuses": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "required_columns": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "identifier_columns": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "column",
                        "kind"
                      ],
                      "properties": {
                        "column": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "enum": [
                            "requirement",
                            "criterion",
                            "work-item"
                          ]
                        }
                      }
                    }
                  },
                  "source_link_column": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "target_link_column": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "allowed_source_profile_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "allowed_target_profile_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "reciprocal_evidence": {
                    "type": "boolean"
                  },
                  "allow_explicit_exclusion": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "placeholder_policy": {
            "enum": [
              "forbidden",
              "template-only"
            ]
          }
        }
      }
    },
    "lifecycle_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "profile_ids",
          "states",
          "transitions"
        ],
        "properties": {
          "family": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "profile_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "states": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "enum": [
                "mutable",
                "current",
                "terminal"
              ]
            }
          },
          "transitions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
