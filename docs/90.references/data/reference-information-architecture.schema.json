{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/schemas/reference-information-architecture.schema.json",
  "title": "Reference Information Architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "evidenceCutoff",
    "currentPackRegistry",
    "snapshotGuard",
    "currentPackBaselines",
    "baselineTransitions",
    "baselineSettlements",
    "mutableIndexProjections",
    "dataAssets",
    "generatedAssets",
    "duplicateRules"
  ],
  "properties": {
    "$schema": {"const": "./reference-information-architecture.schema.json"},
    "schemaVersion": {"const": 2},
    "evidenceCutoff": {"$ref": "#/$defs/date"},
    "currentPackRegistry": {"$ref": "#/$defs/path"},
    "snapshotGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "historicalPackIds"],
      "properties": {
        "sourceCommit": {"$ref": "#/$defs/commit"},
        "historicalPackIds": {"$ref": "#/$defs/packIds"}
      }
    },
    "currentPackBaselines": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/packId"},
      "additionalProperties": {"$ref": "#/$defs/commit"}
    },
    "baselineTransitions": {
      "type": "array",
      "maxItems": 1,
      "items": {"$ref": "#/$defs/transition"}
    },
    "baselineSettlements": {
      "type": "array",
      "maxItems": 1,
      "items": {"$ref": "#/$defs/settlement"}
    },
    "mutableIndexProjections": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/projection"}
    },
    "dataAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repositoryEvidence", "refreshTrigger", "sources"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "repositoryEvidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/path"}
          },
          "refreshTrigger": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "checkedOn", "adoptedScope", "rejectedScope"],
              "properties": {
                "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
                "checkedOn": {"$ref": "#/$defs/date"},
                "adoptedScope": {"$ref": "#/$defs/nonEmptyStrings"},
                "rejectedScope": {"$ref": "#/$defs/nonEmptyStrings"}
              }
            }
          }
        }
      }
    },
    "generatedAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "generatorPath", "inputRoots", "outputPath", "checkCommand", "canonicalOwnerPath"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "generatorPath": {"$ref": "#/$defs/path"},
          "inputRoots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/path"}
          },
          "outputPath": {"$ref": "#/$defs/path"},
          "checkCommand": {"type": "string", "minLength": 1},
          "canonicalOwnerPath": {"$ref": "#/$defs/path"}
        }
      }
    },
    "duplicateRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalOwnerRoots", "minimumParagraphCharacters", "structuralExceptions"],
      "properties": {
        "canonicalOwnerRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "minimumParagraphCharacters": {"type": "integer", "minimum": 1},
        "structuralExceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canonicalOwnerPath", "referencePath", "paragraphSha256", "structuralRole", "reason"],
            "properties": {
              "canonicalOwnerPath": {"$ref": "#/$defs/path"},
              "referencePath": {"$ref": "#/$defs/path"},
              "paragraphSha256": {"$ref": "#/$defs/sha256"},
              "structuralRole": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "packId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*$"},
    "packIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/packId"}
    },
    "commit": {"type": "string", "pattern": "^git-sha1:[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?=.{1,512}$)[^\\r\\n]*\\S[^\\r\\n]*$"
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "packId", "fromCommit", "subject", "targetSha256", "targetByteLength", "reason"],
      "properties": {
        "id": {"const": "ria-007-postflight-ledger"},
        "packId": {"const": "research/2026-07-07-wer"},
        "fromCommit": {"$ref": "#/$defs/commit"},
        "subject": {"const": "document-migration-evidence-ledger"},
        "targetSha256": {"$ref": "#/$defs/sha256"},
        "targetByteLength": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "reason": {"$ref": "#/$defs/reason"}
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "packId", "fromCommit", "subject", "targetSha256", "targetByteLength", "reason", "transitionCommit"],
      "properties": {
        "id": {"const": "ria-007-postflight-ledger"},
        "packId": {"const": "research/2026-07-07-wer"},
        "fromCommit": {"$ref": "#/$defs/commit"},
        "subject": {"const": "document-migration-evidence-ledger"},
        "targetSha256": {"$ref": "#/$defs/sha256"},
        "targetByteLength": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "reason": {"$ref": "#/$defs/reason"},
        "transitionCommit": {"$ref": "#/$defs/commit"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "minProperties": 2,
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "completeBody": {"const": true},
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["section", "columns"],
          "properties": {
            "section": {"type": "string", "minLength": 1},
            "columns": {"$ref": "#/$defs/nonEmptyStrings"}
          }
        },
        "navigationReplacement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visibleText", "destination"],
          "properties": {
            "visibleText": {"type": "string", "minLength": 1},
            "destination": {"$ref": "#/$defs/path"}
          }
        }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:docs|scripts|tests)(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)+$"
    }
  }
}
