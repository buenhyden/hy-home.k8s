{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s.local/schemas/agent-loop-lifecycle.schema.json",
  "title": "Agent Loop Lifecycle Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "contractVersion",
    "currentOwner",
    "providerNeutral",
    "authority",
    "stateMachine",
    "failureNormalization",
    "retryPolicy",
    "noProgressPolicy",
    "nonRetryableFailureClasses",
    "progressPolicy",
    "eventRecord",
    "checkpointBoundary",
    "feedbackRouting",
    "interfaces"
  ],
  "properties": {
    "$schema": {
      "const": "./agent-loop-lifecycle.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "contractId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "currentOwner": {
      "$ref": "#/$defs/currentOwner"
    },
    "providerNeutral": {
      "type": "boolean"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "stateMachine": {
      "$ref": "#/$defs/stateMachine"
    },
    "failureNormalization": {
      "$ref": "#/$defs/failureNormalization"
    },
    "retryPolicy": {
      "$ref": "#/$defs/retryPolicy"
    },
    "noProgressPolicy": {
      "$ref": "#/$defs/noProgressPolicy"
    },
    "nonRetryableFailureClasses": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonRetryableFailureClass"
      }
    },
    "progressPolicy": {
      "$ref": "#/$defs/progressPolicy"
    },
    "eventRecord": {
      "$ref": "#/$defs/eventRecord"
    },
    "checkpointBoundary": {
      "$ref": "#/$defs/checkpointBoundary"
    },
    "feedbackRouting": {
      "$ref": "#/$defs/feedbackRouting"
    },
    "interfaces": {
      "$ref": "#/$defs/interfaces"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "currentOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contractVersion",
        "status"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "current"
          ]
        }
      }
    },
    "stateId": {
      "enum": [
        "ready",
        "running",
        "validating",
        "retry-assessment",
        "completed",
        "blocked",
        "escalated",
        "aborted"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "implementationScope",
        "acceptanceCriteria",
        "checkpointControlsOwner"
      ],
      "properties": {
        "spec": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "implementationScope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "VAL-AHLL-001",
              "VAL-AHLL-002",
              "VAL-AHLL-003",
              "VAL-AHLL-004"
            ]
          }
        },
        "checkpointControlsOwner": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "terminal",
        "meaning"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stateId"
        },
        "terminal": {
          "type": "boolean"
        },
        "meaning": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "event",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/stateId"
        },
        "event": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "to": {
          "$ref": "#/$defs/stateId"
        }
      }
    },
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialState",
        "states",
        "transitions",
        "automaticTerminalStates"
      ],
      "properties": {
        "initialState": {
          "$ref": "#/$defs/stateId"
        },
        "states": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "automaticTerminalStates": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stateId"
          }
        }
      }
    },
    "failureNormalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signatureVersion",
        "digestAlgorithm",
        "signatureFields",
        "excludedFields",
        "boundedDiagnosticRequired",
        "semanticEquivalenceAcrossProviders",
        "providerEvidenceRetainedSeparately",
        "rawOutputAllowed"
      ],
      "properties": {
        "signatureVersion": {
          "type": "integer",
          "minimum": 1
        },
        "digestAlgorithm": {
          "enum": [
            "sha256"
          ]
        },
        "signatureFields": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "excludedFields": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "boundedDiagnosticRequired": {
          "type": "boolean"
        },
        "semanticEquivalenceAcrossProviders": {
          "type": "boolean"
        },
        "providerEvidenceRetainedSeparately": {
          "type": "boolean"
        },
        "rawOutputAllowed": {
          "type": "boolean"
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialFailureCountsAsRetry",
        "maxAutomaticRetriesPerSignature",
        "defaultMaxAutomaticRecoveryActionsPerTask",
        "effectiveRecoveryLimit",
        "counterScope",
        "signatureRetriesKeyedByNormalizedSignature",
        "providerFallbackResetsCounters",
        "modelFallbackResetsCounters",
        "handoffResetsCounters",
        "signatureChangeResetsTaskRecoveryCounter",
        "retryRequiresDifferentAction",
        "automaticRecoveryActionKinds",
        "budgetExhaustionDecision",
        "evaluationOrder"
      ],
      "properties": {
        "initialFailureCountsAsRetry": {
          "type": "boolean"
        },
        "maxAutomaticRetriesPerSignature": {
          "type": "integer",
          "minimum": 0
        },
        "defaultMaxAutomaticRecoveryActionsPerTask": {
          "type": "integer",
          "minimum": 0
        },
        "effectiveRecoveryLimit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "counterScope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "signatureRetriesKeyedByNormalizedSignature": {
          "type": "boolean"
        },
        "providerFallbackResetsCounters": {
          "type": "boolean"
        },
        "modelFallbackResetsCounters": {
          "type": "boolean"
        },
        "handoffResetsCounters": {
          "type": "boolean"
        },
        "signatureChangeResetsTaskRecoveryCounter": {
          "type": "boolean"
        },
        "retryRequiresDifferentAction": {
          "type": "boolean"
        },
        "automaticRecoveryActionKinds": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "budgetExhaustionDecision": {
          "enum": [
            "escalate",
            "stop"
          ]
        },
        "evaluationOrder": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "noProgressPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultIdentityFields",
        "maxConsecutiveIdenticalResultsWithoutProgress",
        "secondObservationDecision",
        "secondObservationState",
        "consumesRetryBudgetBeforeStop",
        "progressResetsConsecutiveCount",
        "providerChangeResetsSequence",
        "modelChangeResetsSequence"
      ],
      "properties": {
        "resultIdentityFields": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "maxConsecutiveIdenticalResultsWithoutProgress": {
          "type": "integer",
          "minimum": 1
        },
        "secondObservationDecision": {
          "enum": [
            "escalate",
            "stop"
          ]
        },
        "secondObservationState": {
          "$ref": "#/$defs/stateId"
        },
        "consumesRetryBudgetBeforeStop": {
          "type": "boolean"
        },
        "progressResetsConsecutiveCount": {
          "type": "boolean"
        },
        "providerChangeResetsSequence": {
          "type": "boolean"
        },
        "modelChangeResetsSequence": {
          "type": "boolean"
        }
      }
    },
    "nonRetryableFailureClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "retryable",
        "decision",
        "terminalState"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "retryable": {
          "type": "boolean"
        },
        "decision": {
          "enum": [
            "escalate",
            "stop"
          ]
        },
        "terminalState": {
          "$ref": "#/$defs/stateId"
        }
      }
    },
    "progressPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedDeltaClasses",
        "rejectedSignals",
        "requiresAtLeastOneAuthorizedDelta",
        "requiresDeterministicEvidence",
        "providerProseIsEvidence"
      ],
      "properties": {
        "allowedDeltaClasses": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "rejectedSignals": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "requiresAtLeastOneAuthorizedDelta": {
          "type": "boolean"
        },
        "requiresDeterministicEvidence": {
          "type": "boolean"
        },
        "providerProseIsEvidence": {
          "type": "boolean"
        }
      }
    },
    "eventRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredFields",
        "prohibitedFields",
        "rawPayloadAllowed"
      ],
      "properties": {
        "requiredFields": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "prohibitedFields": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "rawPayloadAllowed": {
          "type": "boolean"
        }
      }
    },
    "checkpointBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaRef",
        "implementationOwner",
        "implementationState",
        "repositoryStateWins",
        "executableValidationDelegated",
        "memoryClassIds"
      ],
      "properties": {
        "schemaRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "implementationOwner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "implementationState": {
          "const": "executable"
        },
        "repositoryStateWins": {
          "type": "boolean"
        },
        "executableValidationDelegated": {
          "type": "boolean"
        },
        "memoryClassIds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "working-short-term",
              "durable-long-term",
              "domain-scoped",
              "provider-local-auxiliary"
            ]
          }
        }
      }
    },
    "feedbackDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ownerRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ownerRef": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "feedbackRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "selection",
        "reviewRequired",
        "rawTracePromptTranscriptPromotionAllowed",
        "destinations"
      ],
      "properties": {
        "trigger": {
          "const": "repeated-stable-failure"
        },
        "selection": {
          "const": "exactly-one-reviewed-destination"
        },
        "reviewRequired": {
          "const": true
        },
        "rawTracePromptTranscriptPromotionAllowed": {
          "const": false
        },
        "destinations": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/feedbackDestination"
          }
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature",
        "implementationOwner",
        "implementationState"
      ],
      "properties": {
        "signature": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "implementationOwner": {
          "enum": [
            "AHLL-001",
            "AHLL-002"
          ]
        },
        "implementationState": {
          "enum": [
            "executable",
            "declaration-only"
          ]
        }
      }
    },
    "ahll002ExecutableInterface": {
      "allOf": [
        {
          "$ref": "#/$defs/interface"
        },
        {
          "properties": {
            "implementationState": {
              "const": "executable"
            }
          }
        }
      ]
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalizeFailure",
        "measureProgress",
        "decideNext",
        "writeCheckpoint",
        "resume",
        "handoff"
      ],
      "properties": {
        "normalizeFailure": {
          "$ref": "#/$defs/interface"
        },
        "measureProgress": {
          "$ref": "#/$defs/interface"
        },
        "decideNext": {
          "$ref": "#/$defs/interface"
        },
        "writeCheckpoint": {
          "$ref": "#/$defs/ahll002ExecutableInterface"
        },
        "resume": {
          "$ref": "#/$defs/ahll002ExecutableInterface"
        },
        "handoff": {
          "$ref": "#/$defs/ahll002ExecutableInterface"
        }
      }
    }
  }
}
