{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/contracts/agent-governance-ci.schema.json",
  "title": "Agent-governance CI topology and local QA evidence contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractVersion",
    "resultVocabulary",
    "evidenceVocabulary",
    "selector",
    "job",
    "summary",
    "requiredRouteClasses",
    "delegatedChecks",
    "gateCommands",
    "securityBoundary",
    "deferredEvidence",
    "localQa"
  ],
  "properties": {
    "$schema": {
      "const": "./agent-governance-ci.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "resultVocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["PASS", "FAIL", "SKIP", "DEFER"]
      }
    },
    "evidenceVocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["repo-static", "provider-runtime", "ci", "remote-live"]
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "stepId",
        "output",
        "expression",
        "selectedValue",
        "unselectedValue"
      ],
      "properties": {
        "jobId": {"type": "string", "minLength": 1},
        "stepId": {"type": "string", "minLength": 1},
        "output": {"type": "string", "minLength": 1},
        "expression": {"type": "string", "minLength": 1},
        "selectedValue": {"type": "string", "minLength": 1},
        "unselectedValue": {"type": "string", "minLength": 1}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "needs", "if", "evidence", "allowedResults"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "needs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "if": {"type": "string", "minLength": 1},
        "evidence": {
          "enum": ["repo-static", "provider-runtime", "ci", "remote-live"]
        },
        "allowedResults": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["PASS", "FAIL", "SKIP", "DEFER"]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "needs",
        "if",
        "selectedEnv",
        "resultEnv",
        "runSha256",
        "truthTable",
        "defaultResult"
      ],
      "properties": {
        "jobId": {"type": "string", "minLength": 1},
        "needs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "if": {"type": "string", "minLength": 1},
        "selectedEnv": {"type": "string", "minLength": 1},
        "resultEnv": {"type": "string", "minLength": 1},
        "runSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "truthTable": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/truthRow"}
        },
        "defaultResult": {
          "enum": ["PASS", "FAIL", "SKIP", "DEFER"]
        }
      }
    },
    "requiredRouteClasses": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/routeClass"}
    },
    "delegatedChecks": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {"$ref": "#/$defs/delegatedCheck"}
    },
    "gateCommands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selfTest", "production"],
      "properties": {
        "selfTest": {"type": "string", "minLength": 1},
        "production": {"type": "string", "minLength": 1}
      }
    },
    "securityBoundary": {
      "$ref": "#/$defs/securityBoundary"
    },
    "deferredEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/deferredEvidence"}
    },
    "localQa": {
      "$ref": "#/$defs/localQa"
    }
  },
  "$defs": {
    "localQa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "sequence",
        "commands",
        "consumerSurfaces",
        "formatterCompletion",
        "inventory"
      ],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "sequence": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "affectedRunner",
            "stagedRunner",
            "stagedHooks",
            "allFiles",
            "diffCheck",
            "cachedDiffCheck"
          ],
          "properties": {
            "affectedRunner": {"type": "string", "minLength": 1},
            "stagedRunner": {"type": "string", "minLength": 1},
            "stagedHooks": {"type": "string", "minLength": 1},
            "allFiles": {"type": "string", "minLength": 1},
            "diffCheck": {"type": "string", "minLength": 1},
            "cachedDiffCheck": {"type": "string", "minLength": 1}
          }
        },
        "consumerSurfaces": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "formatterCompletion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mutationResult",
            "requiredFinalResult",
            "rerun"
          ],
          "properties": {
            "mutationResult": {"type": "string", "minLength": 1},
            "requiredFinalResult": {
              "enum": ["PASS", "FAIL", "SKIP", "DEFER"]
            },
            "rerun": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "truthCases",
            "mutationCases",
            "delegatedChecks",
            "deferredOwners",
            "qaSurfaces",
            "legacyPositiveCases",
            "legacyMutationCases"
          ],
          "properties": {
            "truthCases": {"type": "integer", "minimum": 1},
            "mutationCases": {"type": "integer", "minimum": 1},
            "delegatedChecks": {"type": "integer", "minimum": 1},
            "deferredOwners": {"type": "integer", "minimum": 1},
            "qaSurfaces": {"type": "integer", "minimum": 1},
            "legacyPositiveCases": {"type": "integer", "minimum": 1},
            "legacyMutationCases": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "truthRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "conclusion", "result"],
      "properties": {
        "selected": {"type": "boolean"},
        "conclusion": {
          "enum": ["success", "skipped", "cancelled", "missing", "failure"]
        },
        "result": {
          "enum": ["PASS", "FAIL", "SKIP", "DEFER"]
        }
      }
    },
    "routeClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "jobId", "validatorId"],
      "properties": {
        "surfaceId": {"type": "string", "minLength": 1},
        "jobId": {"type": "string", "minLength": 1},
        "validatorId": {"type": "string", "minLength": 1}
      }
    },
    "delegatedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "evidence", "allowedResults"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "evidence": {
          "enum": ["repo-static", "provider-runtime", "ci", "remote-live"]
        },
        "allowedResults": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["PASS", "FAIL", "SKIP", "DEFER"]
          }
        }
      }
    },
    "securityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowPermissions",
        "checkoutAction",
        "checkout",
        "remoteUsesPin",
        "providerEvidenceAggregate",
        "forbiddenCommandClasses"
      ],
      "properties": {
        "workflowPermissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contents"],
          "properties": {
            "contents": {"enum": ["read", "write"]}
          }
        },
        "checkoutAction": {"type": "string", "minLength": 1},
        "checkout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["persistCredentials", "fetchDepth"],
          "properties": {
            "persistCredentials": {"type": "boolean"},
            "fetchDepth": {"type": "integer", "minimum": 0}
          }
        },
        "remoteUsesPin": {"type": "string", "minLength": 1},
        "providerEvidenceAggregate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "focusedValidators"],
          "properties": {
            "path": {
              "const": "scripts/validate-agent-provider-evidence.py"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "focusedValidators": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "validate-agent-provider-config.py",
                  "validate-agent-provider-canaries.py"
                ]
              }
            }
          }
        },
        "forbiddenCommandClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "deferredEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "result", "scope"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "result": {
          "enum": ["PASS", "FAIL", "SKIP", "DEFER"]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
