{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/contracts/agent-legacy-cutover.schema.json",
  "title": "Agent legacy consumer cutover contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractVersion",
    "currentOwnerSpec",
    "resultVocabulary",
    "evidenceVocabulary",
    "retiredSurfaces",
    "replacementSurfaces",
    "harnessCutover",
    "currentAuthorityMigrations",
    "referencePolicy",
    "scanPolicy",
    "commands",
    "exitCodes"
  ],
  "properties": {
    "$schema": {
      "const": "./agent-legacy-cutover.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "currentOwnerSpec": {
      "const": "docs/03.specs/0045-agent-governance-ci-qa-cutover/spec.md"
    },
    "resultVocabulary": {
      "type": "array",
      "prefixItems": [
        {
          "const": "PASS"
        },
        {
          "const": "FAIL"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "evidenceVocabulary": {
      "type": "array",
      "prefixItems": [
        {
          "const": "repo-static"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "retiredSurfaces": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "replacementSurfaces": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "harnessCutover": {
      "$ref": "#/$defs/harnessCutover"
    },
    "currentAuthorityMigrations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/currentAuthorityMigration"
      }
    },
    "referencePolicy": {
      "$ref": "#/$defs/referencePolicy"
    },
    "scanPolicy": {
      "$ref": "#/$defs/scanPolicy"
    },
    "commands": {
      "$ref": "#/$defs/commands"
    },
    "exitCodes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/exitCode"
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "harnessCutover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractPath",
        "schemaPath",
        "consumersKey",
        "selectedConsumer",
        "retiredConsumerIds",
        "forbiddenTopLevelKeys"
      ],
      "properties": {
        "contractPath": {
          "$ref": "#/$defs/repositoryPath"
        },
        "schemaPath": {
          "$ref": "#/$defs/repositoryPath"
        },
        "consumersKey": {
          "const": "consumers"
        },
        "selectedConsumer": {
          "$ref": "#/$defs/consumer"
        },
        "retiredConsumerIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenTopLevelKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "const": "harness-semantics-validator"
        },
        "path": {
          "const": "scripts/validate-agent-harness-semantics.py"
        }
      }
    },
    "currentAuthorityMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "from",
        "to",
        "count"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "from": {
          "$ref": "#/$defs/repositoryPath"
        },
        "to": {
          "$ref": "#/$defs/repositoryPath"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "referencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageReferences",
        "migrationReferences",
        "allowedReferenceCounts",
        "protectedEvidenceFiles",
        "terminalStatuses"
      ],
      "properties": {
        "packageReferences": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "migrationReferences": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "allowedReferenceCounts": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/allowedReferenceCount"
          }
        },
        "protectedEvidenceFiles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/protectedEvidenceFile"
          }
        },
        "terminalStatuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          }
        }
      }
    },
    "allowedReferenceCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "counts"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "counts": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0}
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      }
    },
    "protectedEvidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "evidenceKind",
        "lifecycleStatus",
        "observedAt",
        "sourceCommit",
        "retiredReference",
        "supersededBy",
        "count"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidenceKind": {
          "enum": [
            "pinned-activation-snapshot",
            "pinned-ria-snapshot"
          ]
        },
        "lifecycleStatus": {
          "const": "superseded"
        },
        "observedAt": {
          "type": "string",
          "format": "date"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "retiredReference": {
          "$ref": "#/$defs/repositoryPath"
        },
        "supersededBy": {
          "$ref": "#/$defs/repositoryPath"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scanPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "excludedRoots",
        "candidateSource",
        "resourceLimits",
        "alwaysActivePrefixes",
        "alwaysActiveFiles",
        "allowedInternalSymlinks"
      ],
      "properties": {
        "root": {
          "const": "."
        },
        "excludedRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "candidateSource": {
          "const": "git-ls-files-z-cached"
        },
        "resourceLimits": {
          "$ref": "#/$defs/resourceLimits"
        },
        "alwaysActivePrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "pattern": "/$"
          }
        },
        "alwaysActiveFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "allowedInternalSymlinks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/internalSymlink"
          }
        }
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitTimeoutSeconds",
        "gitCleanupTimeoutSeconds",
        "gitStdoutBytes",
        "gitStderrBytes",
        "candidateCount",
        "candidatePathBytes",
        "regularFileBytes",
        "diagnosticDetailBytes"
      ],
      "properties": {
        "gitTimeoutSeconds": {
          "const": 10
        },
        "gitCleanupTimeoutSeconds": {
          "const": 2
        },
        "gitStdoutBytes": {
          "const": 262144
        },
        "gitStderrBytes": {
          "const": 16384
        },
        "candidateCount": {
          "const": 2048
        },
        "candidatePathBytes": {
          "const": 1024
        },
        "regularFileBytes": {
          "const": 8388608
        },
        "diagnosticDetailBytes": {
          "const": 512
        }
      }
    },
    "internalSymlink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "target"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\).+$"
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selfTest",
        "production"
      ],
      "properties": {
        "selfTest": {
          "type": "string",
          "minLength": 1
        },
        "production": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exitCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "result"
      ],
      "properties": {
        "code": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    }
  }
}
