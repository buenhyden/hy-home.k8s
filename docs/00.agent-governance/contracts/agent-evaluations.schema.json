{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./agent-evaluations.schema.json",
  "title": "Spec 044 repository-static agent evaluation readiness contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "contractVersion",
    "state",
    "ownerSpec",
    "versionHistory",
    "authority",
    "harnessBinding",
    "fixedSourceCutoff",
    "memoryClasses",
    "requiredFixtureClasses",
    "privacyPolicy",
    "promotionPolicy",
    "evaluationRecordContract",
    "roleSuites",
    "corpusManifest",
    "adjudicationReadiness",
    "rollbackRecords",
    "finalAdmissionDecision"
  ],
  "properties": {
    "$schema": {
      "const": "./agent-evaluations.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "contractId": {
      "const": "hy-home.k8s/agent-evaluations"
    },
    "contractVersion": {
      "const": "1.1.0"
    },
    "state": {
      "const": "repository-static-evaluation-ready"
    },
    "ownerSpec": {
      "const": "docs/03.specs/0044-agent-roster-evaluation-and-admission/spec.md"
    },
    "versionHistory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/versionHistoryEntry"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "harnessBinding": {
      "$ref": "#/$defs/harnessBinding"
    },
    "fixedSourceCutoff": {
      "$ref": "#/$defs/fixedSourceCutoff"
    },
    "memoryClasses": {
      "const": [
        "working-short-term",
        "durable-long-term",
        "domain-scoped",
        "provider-local-auxiliary"
      ]
    },
    "requiredFixtureClasses": {
      "const": [
        "positive",
        "negative-adversarial",
        "refusal-stop",
        "handoff"
      ]
    },
    "privacyPolicy": {
      "$ref": "#/$defs/privacyPolicy"
    },
    "promotionPolicy": {
      "$ref": "#/$defs/promotionPolicy"
    },
    "evaluationRecordContract": {
      "$ref": "#/$defs/evaluationRecordContract"
    },
    "roleSuites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/roleSuite"
      },
      "minItems": 12,
      "maxItems": 12
    },
    "corpusManifest": {
      "$ref": "#/$defs/corpusManifest"
    },
    "adjudicationReadiness": {
      "$ref": "#/$defs/adjudicationReadiness"
    },
    "rollbackRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rollbackRecord"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "finalAdmissionDecision": {
      "$ref": "#/$defs/finalAdmissionDecision"
    }
  },
  "$defs": {
    "versionHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "state",
        "evidenceScope",
        "admissionDisposition"
      ],
      "properties": {
        "contractVersion": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        },
        "state": {
          "enum": [
            "superseded-string-manifest-scaffold",
            "current-corpus-ready"
          ]
        },
        "evidenceScope": {
          "enum": [
            "repository-static-schema-only",
            "repository-static-evaluation-readiness"
          ]
        },
        "admissionDisposition": {
          "const": "DEFER"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidenceKind",
        "execution",
        "runtime",
        "providerResolution",
        "authentication",
        "liveAction",
        "evaluationDecision"
      ],
      "properties": {
        "state": {
          "const": "repository-static-evaluation-ready"
        },
        "evidenceKind": {
          "const": "repo-static"
        },
        "execution": {
          "const": "DEFER"
        },
        "runtime": {
          "const": "DEFER"
        },
        "providerResolution": {
          "const": "DEFER"
        },
        "authentication": {
          "const": "DEFER"
        },
        "liveAction": {
          "const": "DEFER"
        },
        "evaluationDecision": {
          "const": "DEFER"
        }
      }
    },
    "harnessBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractPath",
        "contractId",
        "contractVersion",
        "roleSetSource",
        "evalSuiteField"
      ],
      "properties": {
        "contractPath": {
          "const": "docs/00.agent-governance/contracts/harness-contract.json"
        },
        "contractId": {
          "const": "hy-home.k8s/agent-harness"
        },
        "contractVersion": {
          "const": "1.0.0"
        },
        "roleSetSource": {
          "const": "#/canonicalRoles"
        },
        "evalSuiteField": {
          "const": "evalSuite.id"
        }
      }
    },
    "fixedSourceCutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localTime",
        "instantUtc"
      ],
      "properties": {
        "localTime": {
          "const": "2026-07-10 10:00 Asia/Seoul"
        },
        "instantUtc": {
          "const": "2026-07-10T01:00:00Z"
        }
      }
    },
    "privacyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material",
        "secretsAllowed",
        "rawPromptsAllowed",
        "fullTranscriptsAllowed",
        "authenticationMaterialAllowed",
        "shellHistoryAllowed",
        "privateDiagnosticsAllowed",
        "productionDataAllowed"
      ],
      "properties": {
        "material": {
          "const": "synthetic-or-redacted-only"
        },
        "secretsAllowed": {
          "const": false
        },
        "rawPromptsAllowed": {
          "const": false
        },
        "fullTranscriptsAllowed": {
          "const": false
        },
        "authenticationMaterialAllowed": {
          "const": false
        },
        "shellHistoryAllowed": {
          "const": false
        },
        "privateDiagnosticsAllowed": {
          "const": false
        },
        "productionDataAllowed": {
          "const": false
        }
      }
    },
    "promotionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineComparison",
        "highRiskAdjudication",
        "qualitySafetyBeforeCostLatency",
        "blockingEvents",
        "promotionState"
      ],
      "properties": {
        "baselineComparison": {
          "const": "same-suite-and-grader"
        },
        "highRiskAdjudication": {
          "const": "independent-required"
        },
        "qualitySafetyBeforeCostLatency": {
          "const": true
        },
        "blockingEvents": {
          "const": [
            "critical-miss",
            "secret-disclosure",
            "scope-escape",
            "unsafe-live-action"
          ]
        },
        "promotionState": {
          "const": "DEFER"
        }
      }
    },
    "suiteFieldContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idField",
        "versionField",
        "required"
      ],
      "properties": {
        "idField": {
          "const": "suiteId"
        },
        "versionField": {
          "const": "suiteVersion"
        },
        "required": {
          "const": true
        }
      }
    },
    "digestContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "algorithm",
        "format",
        "source",
        "required"
      ],
      "properties": {
        "field": {
          "const": "inputDigest"
        },
        "algorithm": {
          "const": "sha256"
        },
        "format": {
          "const": "sha256:<64-lowercase-hex>"
        },
        "source": {
          "const": "utf8-scenario-summary"
        },
        "required": {
          "const": true
        }
      }
    },
    "expectedBehaviorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pathsField",
        "toolsField",
        "prohibitedActionsField",
        "stopHandoffField"
      ],
      "properties": {
        "pathsField": {
          "const": "allowedPaths"
        },
        "toolsField": {
          "const": "allowedTools"
        },
        "prohibitedActionsField": {
          "const": "prohibitedActions"
        },
        "stopHandoffField": {
          "const": "stopHandoffExpectation"
        }
      }
    },
    "fixtureContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityFields",
        "requiredClasses",
        "evidenceFields",
        "digest",
        "expectedBehavior"
      ],
      "properties": {
        "identityFields": {
          "const": [
            "fixtureId",
            "fixtureVersion",
            "roleId",
            "roleContractVersion",
            "fixtureClass"
          ]
        },
        "requiredClasses": {
          "const": [
            "positive",
            "negative-adversarial",
            "refusal-stop",
            "handoff"
          ]
        },
        "evidenceFields": {
          "const": [
            "scenarioSummary",
            "provenanceClass",
            "privacyClass",
            "riskClass",
            "inputDigest",
            "expectedBoundaryBehavior"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digestContract"
        },
        "expectedBehavior": {
          "$ref": "#/$defs/expectedBehaviorContract"
        }
      }
    },
    "graderContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionField",
        "rubricVersionField",
        "rubricDimensions"
      ],
      "properties": {
        "versionField": {
          "const": "graderVersion"
        },
        "rubricVersionField": {
          "const": "rubricVersion"
        },
        "rubricDimensions": {
          "const": [
            "quality",
            "safety",
            "cost",
            "latency"
          ]
        }
      }
    },
    "providerExecutionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reasoning",
        "config",
        "canary"
      ],
      "properties": {
        "provider": {
          "const": "DEFER"
        },
        "model": {
          "const": "DEFER"
        },
        "reasoning": {
          "const": "DEFER"
        },
        "config": {
          "const": "DEFER"
        },
        "canary": {
          "const": "DEFER"
        }
      }
    },
    "baselineCandidateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate",
        "sameSuiteVersionRequired",
        "sameGraderVersionRequired"
      ],
      "properties": {
        "baseline": {
          "const": "DEFER"
        },
        "candidate": {
          "const": "DEFER"
        },
        "sameSuiteVersionRequired": {
          "const": true
        },
        "sameGraderVersionRequired": {
          "const": true
        }
      }
    },
    "metricsContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality",
        "safety",
        "cost",
        "latency"
      ],
      "properties": {
        "quality": {
          "const": "DEFER"
        },
        "safety": {
          "const": "DEFER"
        },
        "cost": {
          "const": "DEFER"
        },
        "latency": {
          "const": "DEFER"
        }
      }
    },
    "adjudicationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readinessDisposition",
        "evaluationDisposition",
        "admissionDisposition",
        "independentForHighRisk"
      ],
      "properties": {
        "readinessDisposition": {
          "const": "PASS"
        },
        "evaluationDisposition": {
          "const": "DEFER"
        },
        "admissionDisposition": {
          "const": "DEFER"
        },
        "independentForHighRisk": {
          "const": true
        }
      }
    },
    "rollbackContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "execution",
        "incumbent"
      ],
      "properties": {
        "status": {
          "const": "armed-not-executed"
        },
        "execution": {
          "const": "DEFER"
        },
        "incumbent": {
          "const": "10/3/30"
        }
      }
    },
    "evaluationRecordContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "fixture",
        "grader",
        "providerExecution",
        "baselineCandidate",
        "metrics",
        "adjudication",
        "rollback"
      ],
      "properties": {
        "suite": {
          "$ref": "#/$defs/suiteFieldContract"
        },
        "fixture": {
          "$ref": "#/$defs/fixtureContract"
        },
        "grader": {
          "$ref": "#/$defs/graderContract"
        },
        "providerExecution": {
          "$ref": "#/$defs/providerExecutionContract"
        },
        "baselineCandidate": {
          "$ref": "#/$defs/baselineCandidateContract"
        },
        "metrics": {
          "$ref": "#/$defs/metricsContract"
        },
        "adjudication": {
          "$ref": "#/$defs/adjudicationContract"
        },
        "rollback": {
          "$ref": "#/$defs/rollbackContract"
        }
      }
    },
    "roleSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "roleContractVersion",
        "suiteId",
        "suiteVersion",
        "fixtureManifestId",
        "fixtureVersion",
        "fixtureClasses",
        "fixtureRecordIds",
        "fixtureManifestDigest",
        "graderVersion",
        "rubricVersion",
        "provenanceClass",
        "privacyClass",
        "riskClass",
        "corpusState",
        "independentAdjudicationRequired",
        "evaluationDisposition",
        "adjudicationRef"
      ],
      "properties": {
        "roleId": {
          "enum": [
            "supervisor",
            "code-reviewer",
            "doc-writer",
            "gitops-reviewer",
            "incident-responder",
            "k8s-implementer",
            "network-reviewer",
            "observability-reviewer",
            "security-auditor",
            "wiki-curator",
            "docs-researcher",
            "quality-engineer"
          ]
        },
        "roleContractVersion": {
          "const": "1.0.0"
        },
        "suiteId": {
          "type": "string",
          "pattern": "^eval/[a-z0-9-]+/v1$"
        },
        "suiteVersion": {
          "const": "1.0.0"
        },
        "fixtureManifestId": {
          "type": "string",
          "pattern": "^eval/[a-z0-9-]+/v1/fixtures/v1$"
        },
        "fixtureVersion": {
          "const": "1.0.0"
        },
        "fixtureClasses": {
          "const": [
            "positive",
            "negative-adversarial",
            "refusal-stop",
            "handoff"
          ]
        },
        "fixtureRecordIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^eval/[a-z0-9-]+/v1/fixtures/(positive|negative-adversarial|refusal-stop|handoff)/v1$"
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "fixtureManifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "graderVersion": {
          "const": "1.0.0"
        },
        "rubricVersion": {
          "const": "1.0.0"
        },
        "provenanceClass": {
          "const": "repository-synthetic"
        },
        "privacyClass": {
          "const": "synthetic-only"
        },
        "riskClass": {
          "enum": [
            "high",
            "standard"
          ]
        },
        "corpusState": {
          "const": "repository-static-evaluation-ready"
        },
        "independentAdjudicationRequired": {
          "type": "boolean"
        },
        "evaluationDisposition": {
          "const": "DEFER"
        },
        "adjudicationRef": {
          "type": "string",
          "pattern": "^#/adjudicationReadiness/records/(?:[0-9]|1[01])$"
        }
      }
    },
    "expectedBoundaryBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedPaths",
        "allowedTools",
        "prohibitedActions",
        "stopHandoffExpectation"
      ],
      "properties": {
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedTools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prohibitedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "stopHandoffExpectation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "corpusRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureId",
        "fixtureVersion",
        "suiteId",
        "suiteVersion",
        "roleId",
        "roleContractVersion",
        "fixtureClass",
        "scenarioSummary",
        "inputDigest",
        "provenanceClass",
        "privacyClass",
        "riskClass",
        "expectedBoundaryBehavior"
      ],
      "properties": {
        "fixtureId": {
          "type": "string",
          "pattern": "^eval/[a-z0-9-]+/v1/fixtures/(positive|negative-adversarial|refusal-stop|handoff)/v1$"
        },
        "fixtureVersion": {
          "const": "1.0.0"
        },
        "suiteId": {
          "type": "string",
          "pattern": "^eval/[a-z0-9-]+/v1$"
        },
        "suiteVersion": {
          "const": "1.0.0"
        },
        "roleId": {
          "enum": [
            "supervisor",
            "code-reviewer",
            "doc-writer",
            "gitops-reviewer",
            "incident-responder",
            "k8s-implementer",
            "network-reviewer",
            "observability-reviewer",
            "security-auditor",
            "wiki-curator",
            "docs-researcher",
            "quality-engineer"
          ]
        },
        "roleContractVersion": {
          "const": "1.0.0"
        },
        "fixtureClass": {
          "enum": [
            "positive",
            "negative-adversarial",
            "refusal-stop",
            "handoff"
          ]
        },
        "scenarioSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provenanceClass": {
          "const": "repository-synthetic"
        },
        "privacyClass": {
          "const": "synthetic-only"
        },
        "riskClass": {
          "enum": [
            "high",
            "standard"
          ]
        },
        "expectedBoundaryBehavior": {
          "$ref": "#/$defs/expectedBoundaryBehavior"
        }
      }
    },
    "corpusManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestId",
        "manifestVersion",
        "digestAlgorithm",
        "manifestDigest",
        "recordCount",
        "records"
      ],
      "properties": {
        "manifestId": {
          "const": "hy-home.k8s/agent-evaluation-corpus/v1"
        },
        "manifestVersion": {
          "const": "1.0.0"
        },
        "digestAlgorithm": {
          "const": "sha256-canonical-json"
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "recordCount": {
          "const": 48
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/corpusRecord"
          },
          "minItems": 48,
          "maxItems": 48
        }
      }
    },
    "independenceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateRoleId",
        "adjudicatorRoleId",
        "sameRole",
        "basis"
      ],
      "properties": {
        "candidateRoleId": {
          "enum": [
            "supervisor",
            "code-reviewer",
            "doc-writer",
            "gitops-reviewer",
            "incident-responder",
            "k8s-implementer",
            "network-reviewer",
            "observability-reviewer",
            "security-auditor",
            "wiki-curator",
            "docs-researcher",
            "quality-engineer"
          ]
        },
        "adjudicatorRoleId": {
          "enum": [
            "supervisor",
            "code-reviewer",
            "doc-writer",
            "gitops-reviewer",
            "incident-responder",
            "k8s-implementer",
            "network-reviewer",
            "observability-reviewer",
            "security-auditor",
            "wiki-curator",
            "docs-researcher",
            "quality-engineer"
          ]
        },
        "sameRole": {
          "const": false
        },
        "basis": {
          "const": "distinct-canonical-role-and-no-result-execution-authority"
        }
      }
    },
    "adjudicationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudicationId",
        "adjudicationVersion",
        "roleId",
        "adjudicatorId",
        "adjudicatorOwner",
        "adjudicatorRoleId",
        "roleSeparation",
        "independenceRequired",
        "independenceProof",
        "rubricVersion",
        "rubricRef",
        "evidenceSummary",
        "evidenceDigest",
        "reviewScope",
        "readinessDisposition",
        "evaluationDisposition",
        "admissionDisposition"
      ],
      "properties": {
        "adjudicationId": {
          "type": "string",
          "pattern": "^adjudication/[a-z0-9-]+/v1$"
        },
        "adjudicationVersion": {
          "const": "1.0.0"
        },
        "roleId": {
          "enum": [
            "supervisor",
            "code-reviewer",
            "doc-writer",
            "gitops-reviewer",
            "incident-responder",
            "k8s-implementer",
            "network-reviewer",
            "observability-reviewer",
            "security-auditor",
            "wiki-curator",
            "docs-researcher",
            "quality-engineer"
          ]
        },
        "adjudicatorId": {
          "type": "string",
          "pattern": "^adjudicator/[a-z0-9-]+/v1$"
        },
        "adjudicatorOwner": {
          "const": "workspace-quality-governance"
        },
        "adjudicatorRoleId": {
          "enum": [
            "supervisor",
            "code-reviewer",
            "doc-writer",
            "gitops-reviewer",
            "incident-responder",
            "k8s-implementer",
            "network-reviewer",
            "observability-reviewer",
            "security-auditor",
            "wiki-curator",
            "docs-researcher",
            "quality-engineer"
          ]
        },
        "roleSeparation": {
          "const": "independent-canonical-role"
        },
        "independenceRequired": {
          "type": "boolean"
        },
        "independenceProof": {
          "$ref": "#/$defs/independenceProof"
        },
        "rubricVersion": {
