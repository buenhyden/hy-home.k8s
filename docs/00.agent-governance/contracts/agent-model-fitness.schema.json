{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/schemas/agent-model-fitness-2.schema.json",
  "title": "Spec 044 AREA-004 repository-static model-fitness readiness contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "contractVersion",
    "ownerSpec",
    "contractMode",
    "evidenceClass",
    "lifecycleState",
    "versionHistory",
    "authoritativeCutoff",
    "authorityBoundaries",
    "runtimeBoundaries",
    "evaluationPolicy",
    "rollbackAuthority",
    "evaluationBindings",
    "providers",
    "roleProfiles"
  ],
  "properties": {
    "$schema": {
      "const": "./agent-model-fitness.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "contractId": {
      "const": "hy-home.k8s/agent-model-fitness"
    },
    "contractVersion": {
      "const": "1.1.0"
    },
    "ownerSpec": {
      "const": "docs/03.specs/044-agent-roster-evaluation-and-admission/spec.md"
    },
    "contractMode": {
      "const": "repository-static-fitness-readiness"
    },
    "evidenceClass": {
      "const": "repository-static"
    },
    "lifecycleState": {
      "const": "repository-static-fitness-ready"
    },
    "versionHistory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/versionEntry"
      }
    },
    "authoritativeCutoff": {
      "$ref": "#/$defs/authoritativeCutoff"
    },
    "authorityBoundaries": {
      "$ref": "#/$defs/authorityBoundaries"
    },
    "runtimeBoundaries": {
      "$ref": "#/$defs/runtimeBoundaries"
    },
    "evaluationPolicy": {
      "$ref": "#/$defs/evaluationPolicy"
    },
    "rollbackAuthority": {
      "$ref": "#/$defs/rollbackAuthority"
    },
    "evaluationBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evaluationBinding"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "roleProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/roleProfile"
      }
    }
  },
  "$defs": {
    "versionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "schemaVersion",
        "lifecycleState",
        "disposition"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "lifecycleState": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "superseded",
            "current"
          ]
        }
      }
    },
    "authoritativeCutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityRef",
        "localTime",
        "utc",
        "timezone"
      ],
      "properties": {
        "authorityRef": {
          "type": "string",
          "minLength": 1
        },
        "localTime": {
          "type": "string",
          "format": "date-time"
        },
        "utc": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "const": "Asia/Seoul"
        }
      }
    },
    "authorityBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerRuntimeEvidenceAuthority",
        "providerEvidenceGranularity",
        "roleSpecificRuntimeEvidence",
        "harnessObservationRef",
        "harnessObservationUse",
        "harnessProviderModelAuthority"
      ],
      "properties": {
        "providerRuntimeEvidenceAuthority": {
          "const": true
        },
        "providerEvidenceGranularity": {
          "const": "two-role-class-candidates-per-provider"
        },
        "roleSpecificRuntimeEvidence": {
          "const": "DEFER"
        },
        "harnessObservationRef": {
          "type": "string",
          "minLength": 1
        },
        "harnessObservationUse": {
          "const": "repository-observation-only"
        },
        "harnessProviderModelAuthority": {
          "const": false
        }
      }
    },
    "runtimeBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelResolution",
        "authentication",
        "hostedCI",
        "remoteExecution",
        "liveExecution"
      ],
      "properties": {
        "modelResolution": {
          "const": "DEFER"
        },
        "authentication": {
          "const": "DEFER"
        },
        "hostedCI": {
          "const": "DEFER"
        },
        "remoteExecution": {
          "const": "DEFER"
        },
        "liveExecution": {
          "const": "DEFER"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualityMinimum",
        "safetyMinimum",
        "costMaximumUsd",
        "latencyMaximumMs"
      ],
      "properties": {
        "qualityMinimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "safetyMinimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "costMaximumUsd": {
          "type": "number",
          "minimum": 0
        },
        "latencyMaximumMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evaluationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "sameSuiteRequired",
        "priorityOrder",
        "thresholds",
        "promotionRequirements",
        "validatorPassMeaning",
        "unobservedMetricPolicy"
      ],
      "properties": {
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "sameSuiteRequired": {
          "const": true
        },
        "priorityOrder": {
          "type": "array",
          "items": {
            "enum": [
              "quality",
              "safety",
              "cost",
              "latency"
            ]
          }
        },
        "thresholds": {
          "$ref": "#/$defs/thresholds"
        },
        "promotionRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validatorPassMeaning": {
          "const": "mapping-readiness-only"
        },
        "unobservedMetricPolicy": {
          "const": "remain-DEFER-never-synthesize"
        }
      }
    },
    "rollbackAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluationRecordsRef",
        "admissionCandidatesRef",
        "verifiedIncumbentRef",
        "state",
        "executionEvidence"
      ],
      "properties": {
        "evaluationRecordsRef": {
          "type": "string",
          "minLength": 1
        },
        "admissionCandidatesRef": {
          "type": "string",
          "minLength": 1
        },
        "verifiedIncumbentRef": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "armed-not-executed"
        },
        "executionEvidence": {
          "const": "DEFER"
        }
      }
    },
    "evaluationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "suiteId",
        "suiteVersion",
        "corpusManifestId",
        "corpusManifestVersion",
        "corpusManifestDigest",
        "fixtureManifestDigest",
        "graderVersion",
        "rubricVersion",
        "baselineRef",
        "adjudicatorRef",
        "adjudicatorId"
      ],
      "properties": {
        "roleId": {
          "enum": [
            "supervisor",
            "code-reviewer",
            "doc-writer",
            "gitops-reviewer",
            "incident-responder",
            "k8s-implementer",
            "network-reviewer",
            "observability-reviewer",
            "security-auditor",
            "wiki-curator",
            "docs-researcher",
            "quality-engineer"
          ]
        },
        "suiteId": {
          "type": "string",
          "minLength": 1
        },
        "suiteVersion": {
          "type": "string",
          "minLength": 1
        },
        "corpusManifestId": {
          "type": "string",
          "minLength": 1
        },
        "corpusManifestVersion": {
          "type": "string",
          "minLength": 1
        },
        "corpusManifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fixtureManifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "graderVersion": {
          "type": "string",
          "minLength": 1
        },
        "rubricVersion": {
          "type": "string",
          "minLength": 1
        },
        "baselineRef": {
          "type": "string",
          "minLength": 1
        },
        "adjudicatorRef": {
          "type": "string",
          "minLength": 1
        },
        "adjudicatorId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "roleClassCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleClass",
        "candidateModel",
        "sourceIds",
        "sourceReasoningCandidate",
        "reasoningSupport",
        "providerEvidenceRef",
        "candidateLifecycle",
        "cutoffConfidence",
        "mappingReadiness",
        "runtimeResolution"
      ],
      "properties": {
        "roleClass": {
          "enum": [
            "planning-supervisor",
            "worker-subagent"
          ]
        },
        "candidateModel": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceReasoningCandidate": {
          "type": "string",
          "minLength": 1
        },
        "reasoningSupport": {
          "type": "string",
          "minLength": 1
        },
        "providerEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "candidateLifecycle": {
          "type": "string",
          "minLength": 1
        },
        "cutoffConfidence": {
          "type": "string",
          "minLength": 1
        },
        "mappingReadiness": {
          "enum": [
            "PASS",
            "DEFER"
          ]
        },
        "runtimeResolution": {
          "enum": [
            "PASS",
            "DEFER"
          ]
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "displayName",
        "trackedSurface",
        "runtimeInterface",
        "modelIdentifierPlane",
        "apiVsCliBoundary",
        "roleClassCandidates"
      ],
      "properties": {
        "providerId": {
          "enum": [
            "local",
            "claude",
            "codex",
            "gemini"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "trackedSurface": {
          "type": "string",
          "minLength": 1
        },
        "runtimeInterface": {
          "type": "string",
          "minLength": 1
        },
        "modelIdentifierPlane": {
          "type": "string",
          "minLength": 1
        },
        "apiVsCliBoundary": {
          "type": "string",
          "minLength": 1
        },
        "roleClassCandidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleClassCandidate"
          }
        }
      }
    },
    "tupleEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingRef",
        "baselineMetricsDigest",
        "candidateMetricsDigest",
        "thresholdResult",
        "adjudicatorReadiness",
        "evaluationDisposition"
      ],
      "properties": {
        "bindingRef": {
          "type": "string",
          "minLength": 1
        },
        "baselineMetricsDigest": {
          "type": "string",
          "minLength": 1
        },
        "candidateMetricsDigest": {
          "type": "string",
          "minLength": 1
        },
        "thresholdResult": {
          "enum": [
            "PASS",
            "FAIL",
            "DEFER"
          ]
        },
        "adjudicatorReadiness": {
          "enum": [
            "PASS",
            "DEFER"
          ]
        },
        "evaluationDisposition": {
          "enum": [
            "PASS",
            "FAIL",
            "DEFER"
          ]
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappingReadiness",
        "fitness",
        "promotion",
        "canary",
        "runtime"
      ],
      "properties": {
        "mappingReadiness": {
          "enum": [
            "PASS",
            "FAIL",
            "DEFER"
          ]
        },
        "fitness": {
          "enum": [
            "PASS",
            "FAIL",
            "DEFER"
          ]
        },
        "promotion": {
          "enum": [
            "PASS",
            "FAIL",
            "DEFER"
          ]
        },
        "canary": {
          "enum": [
            "PASS",
            "FAIL",
            "DEFER"
          ]
        },
        "runtime": {
          "enum": [
            "PASS",
            "FAIL",
            "DEFER"
          ]
        }
      }
    },
    "providerTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "providerId",
        "roleClass",
        "capabilityTier",
        "riskTier",
        "incumbentModel",
        "configuredValue",
        "configuredReasoning",
        "observedValue",
        "candidateModel",
        "reasoningCandidate",
        "reasoningSupport",
        "sourceIds",
        "cutoffConfidence",
        "providerEvidenceRef",
        "configPath",
        "evaluation",
        "fallbackPolicy",
        "fallbackTarget",
        "silentFallbackAllowed",
        "rollbackRef",
        "rollbackState",
        "rollbackExecutionEvidence",
        "limitation",
        "retryTrigger",
        "mappingRationale",
        "decisions"
      ],
      "properties": {
        "roleId": {
          "enum": [
            "supervisor",
            "code-reviewer",
            "doc-writer",
            "gitops-reviewer",
            "incident-responder",
            "k8s-implementer",
            "network-reviewer",
            "observability-reviewer",
            "security-auditor",
            "wiki-curator",
            "docs-researcher",
            "quality-engineer"
          ]
        },
        "providerId": {
          "enum": [
            "local",
            "claude",
            "codex",
            "gemini"
          ]
        },
        "roleClass": {
          "enum": [
            "planning-supervisor",
            "worker-subagent"
          ]
        },
        "capabilityTier": {
          "enum": [
            "top",
            "worker"
          ]
        },
        "riskTier": {
          "enum": [
            "high",
            "standard"
          ]
        },
        "incumbentModel": {
          "type": "string",
          "minLength": 1
        },
        "configuredValue": {
          "type": "string",
          "minLength": 1
        },
        "configuredReasoning": {
          "type": "string",
          "minLength": 1
        },
        "observedValue": {
          "type": "string",
          "minLength": 1
        },
        "candidateModel": {
          "type": "string",
          "minLength": 1
        },
        "reasoningCandidate": {
          "type": "string",
          "minLength": 1
        },
        "reasoningSupport": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cutoffConfidence": {
          "type": "string",
          "minLength": 1
        },
        "providerEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "configPath": {
          "type": "string",
          "minLength": 1
        },
        "evaluation": {
          "$ref": "#/$defs/tupleEvaluation"
        },
        "fallbackPolicy": {
          "type": "string",
          "minLength": 1
        },
        "fallbackTarget": {
          "type": "string",
          "minLength": 1
        },
        "silentFallbackAllowed": {
          "type": "boolean"
        },
        "rollbackRef": {
          "type": "string",
          "minLength": 1
        },
        "rollbackState": {
          "type": "string",
          "minLength": 1
        },
        "rollbackExecutionEvidence": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        },
        "retryTrigger": {
          "type": "string",
          "minLength": 1
        },
        "mappingRationale": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "$ref": "#/$defs/decisions"
        }
      }
    },
    "roleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "capabilityTier",
        "riskTier",
        "providerTuples"
      ],
      "properties": {
        "roleId": {
          "enum": [
            "supervisor",
            "code-reviewer",
            "doc-writer",
            "gitops-reviewer",
            "incident-responder",
            "k8s-implementer",
            "network-reviewer",
            "observability-reviewer",
            "security-auditor",
            "wiki-curator",
            "docs-researcher",
            "quality-engineer"
          ]
        },
        "capabilityTier": {
          "enum": [
            "top",
            "worker"
          ]
        },
        "riskTier": {
          "enum": [
            "high",
            "standard"
          ]
        },
        "providerTuples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/providerTuple"
          }
        }
      }
    }
  }
}
