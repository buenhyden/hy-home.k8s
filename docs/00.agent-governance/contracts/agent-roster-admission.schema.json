{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/schemas/agent-roster-admission-1.schema.json",
  "title": "Spec 044 agent roster admission policy contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "contractVersion",
    "ownerSpec",
    "state",
    "fixedSourceCutoff",
    "evidence",
    "currentInventory",
    "targetInventory",
    "externalCatalogPolicy",
    "admissionConditions",
    "candidates",
    "memoryPolicy"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "integer"
    },
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "ownerSpec": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "fixedSourceCutoff": {
      "$ref": "#/$defs/fixedSourceCutoff"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "currentInventory": {
      "$ref": "#/$defs/currentInventory"
    },
    "targetInventory": {
      "$ref": "#/$defs/targetInventory"
    },
    "externalCatalogPolicy": {
      "$ref": "#/$defs/externalCatalogPolicy"
    },
    "admissionConditions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "memoryPolicy": {
      "$ref": "#/$defs/memoryPolicy"
    }
  },
  "$defs": {
    "fixedSourceCutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localTime",
        "instantUtc"
      ],
      "properties": {
        "localTime": {
          "type": "string",
          "minLength": 1
        },
        "instantUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "claimBoundary",
        "admissionVerdict",
        "promotionAuthorized",
        "deferredClasses",
        "deferredClassStates"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "claimBoundary": {
          "type": "string",
          "minLength": 1
        },
        "admissionVerdict": {
          "type": "string",
          "minLength": 1
        },
        "promotionAuthorized": {
          "type": "boolean"
        },
        "deferredClasses": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deferredClassStates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "provider-discovery",
            "provider-authentication",
            "hosted-ci",
            "remote",
            "live"
          ],
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "provider-discovery": {
              "type": "string",
              "minLength": 1
            },
            "provider-authentication": {
              "type": "string",
              "minLength": 1
            },
            "hosted-ci": {
              "type": "string",
              "minLength": 1
            },
            "remote": {
              "type": "string",
              "minLength": 1
            },
            "live": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "currentInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "roleCount",
        "surfaceCount",
        "adapterCount"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "roleCount": {
          "type": "integer",
          "minimum": 0
        },
        "surfaceCount": {
          "type": "integer",
          "minimum": 0
        },
        "adapterCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "targetInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "roleCount",
        "surfaceCount",
        "adapterCount",
        "roleIds",
        "surfaceIds"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "roleCount": {
          "type": "integer",
          "minimum": 0
        },
        "surfaceCount": {
          "type": "integer",
          "minimum": 0
        },
        "adapterCount": {
          "type": "integer",
          "minimum": 0
        },
        "roleIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "surfaceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "externalCatalogPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "authority",
        "directImportAllowed",
        "popularityIsAdmissionEvidence",
        "upstreamPromptIsAdmissionEvidence",
        "localAdmissionEvidenceRequired"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "directImportAllowed": {
          "type": "boolean"
        },
        "popularityIsAdmissionEvidence": {
          "type": "boolean"
        },
        "upstreamPromptIsAdmissionEvidence": {
          "type": "boolean"
        },
        "localAdmissionEvidenceRequired": {
          "type": "boolean"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "decision",
        "authority",
        "distinctDeliverable",
        "requirementGap",
        "overlapAnalysis",
        "owner",
        "inputs",
        "outputs",
        "permissions",
        "allowedTools",
        "allowedPaths",
        "prohibitedActions",
        "stopConditions",
        "handoffs",
        "surfacePlan",
        "evaluationGate",
        "rollback"
      ],
      "properties": {
        "roleId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "distinctDeliverable": {
          "type": "string",
          "minLength": 1
        },
        "requirementGap": {
          "$ref": "#/$defs/requirementGap"
        },
        "overlapAnalysis": {
          "$ref": "#/$defs/overlapAnalysis"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "outputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "permissions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "allowedTools": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "allowedPaths": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "prohibitedActions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "stopConditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "handoffs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "surfacePlan": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/surfacePlan"
          }
        },
        "evaluationGate": {
          "$ref": "#/$defs/evaluationGate"
        },
        "rollback": {
          "$ref": "#/$defs/rollback"
        }
      }
    },
    "requirementGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "requirementId",
        "approved",
        "approvalOwner",
        "recurring",
        "recurrenceEvidence",
        "currentlyOwned",
        "gapStatement"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "requirementId": {
          "type": "string",
          "minLength": 1
        },
        "approved": {
          "type": "boolean"
        },
        "approvalOwner": {
          "type": "string",
          "minLength": 1
        },
        "recurring": {
          "type": "boolean"
        },
        "recurrenceEvidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "currentlyOwned": {
          "type": "boolean"
        },
        "gapStatement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "overlapAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingRolesReviewed",
        "existingRoleCanOwnDeliverable",
        "strengthenExistingRoleResolvesGap",
        "distinctOwnerRequired",
        "rationale"
      ],
      "properties": {
        "existingRolesReviewed": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "existingRoleCanOwnDeliverable": {
          "type": "boolean"
        },
        "strengthenExistingRoleResolvesGap": {
          "type": "boolean"
        },
        "distinctOwnerRequired": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "surfacePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceId",
        "state",
        "adapterPath",
        "leastPrivilege",
        "providerNativeMetadataRequired"
      ],
      "properties": {
        "surfaceId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "adapterPath": {
          "type": "string",
          "minLength": 1
        },
        "leastPrivilege": {
          "type": "boolean"
        },
        "providerNativeMetadataRequired": {
          "type": "boolean"
        }
      }
    },
    "evaluationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classes",
        "baselineState",
        "sameCorpusAndGraderRequired",
        "independentAdjudication"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baselineState": {
          "type": "string",
          "minLength": 1
        },
        "sameCorpusAndGraderRequired": {
          "type": "boolean"
        },
        "independentAdjudication": {
          "$ref": "#/$defs/independentAdjudication"
        }
      }
    },
    "independentAdjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "selfAdjudicationProhibited",
        "adjudicatorOwner",
        "thresholdOrder",
        "criticalMissBlocksPromotion"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "selfAdjudicationProhibited": {
          "type": "boolean"
        },
        "adjudicatorOwner": {
          "type": "string",
          "minLength": 1
        },
        "thresholdOrder": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "criticalMissBlocksPromotion": {
          "type": "boolean"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "restoreInventory",
        "reproducible",
        "executed",
        "triggers",
        "procedure"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "restoreInventory": {
          "type": "string",
          "minLength": 1
        },
        "reproducible": {
          "type": "boolean"
        },
        "executed": {
          "type": "boolean"
        },
        "triggers": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "procedure": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "memoryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classes",
        "repositoryWins",
        "sensitiveDataAllowed",
        "rawPromptOrTranscriptAllowed",
        "prohibitedContent"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repositoryWins": {
          "type": "boolean"
        },
        "sensitiveDataAllowed": {
          "type": "boolean"
        },
        "rawPromptOrTranscriptAllowed": {
          "type": "boolean"
        },
        "prohibitedContent": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
