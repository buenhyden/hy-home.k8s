{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s.local/contracts/agent-checkpoint.schema.json",
  "title": "Agent transient checkpoint",
  "description": "Closed, bounded, redacted schema for the ignored and advisory .agent-work/checkpoint.json recovery carrier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractVersion",
    "checkpointPath",
    "synthetic",
    "atomicWrite",
    "identity",
    "repository",
    "executor",
    "counters",
    "failure",
    "completedWork",
    "remainingWork",
    "validationSummary",
    "nextAction",
    "resume",
    "redaction",
    "compaction",
    "handoff",
    "memoryLifecycle"
  ],
  "properties": {
    "$schema": {
      "const": "docs/00.agent-governance/contracts/agent-checkpoint.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "checkpointPath": {
      "const": ".agent-work/checkpoint.json"
    },
    "synthetic": {
      "type": "boolean"
    },
    "atomicWrite": {
      "$ref": "#/$defs/atomicWrite"
    },
    "identity": {
      "$ref": "#/$defs/checkpointIdentity"
    },
    "repository": {
      "$ref": "#/$defs/repositoryObservation"
    },
    "executor": {
      "$ref": "#/$defs/executor"
    },
    "counters": {
      "$ref": "#/$defs/counters"
    },
    "failure": {
      "$ref": "#/$defs/failure"
    },
    "completedWork": {
      "$ref": "#/$defs/workList"
    },
    "remainingWork": {
      "$ref": "#/$defs/workList"
    },
    "validationSummary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/validationRecord"
      }
    },
    "nextAction": {
      "$ref": "#/$defs/summary"
    },
    "resume": {
      "$ref": "#/$defs/resume"
    },
    "redaction": {
      "$ref": "#/$defs/redaction"
    },
    "compaction": {
      "$ref": "#/$defs/compaction"
    },
    "handoff": {
      "$ref": "#/$defs/handoff"
    },
    "memoryLifecycle": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/memoryLifecycle"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "owner": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:[-/][a-z0-9]+)*$"
    },
    "repoRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:\\.?[A-Za-z0-9_-]+)(?:/[A-Za-z0-9._-]+)*$"
    },
    "evidenceRef": {
      "type": "string",
      "minLength": 8,
      "maxLength": 240,
      "pattern": "^(?:docs|scripts|tests|\\.agents|\\.claude|\\.codex|\\.github)/[A-Za-z0-9._/-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^git-sha1:[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "summaryList": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/summary"
      }
    },
    "workList": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "atomicWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "strategy",
        "targetPath",
        "partialWriteAllowed"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "strategy": {
          "enum": [
            "same-directory-temp-fsync-replace"
          ]
        },
        "targetPath": {
          "const": ".agent-work/checkpoint.json"
        },
        "partialWriteAllowed": {
          "type": "boolean"
        }
      }
    },
    "checkpointIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "taskId",
        "specRef",
        "worktreeId",
        "providerSurfaceId",
        "providerSessionInstanceDigest",
        "namespaceDigest",
        "writerId",
        "writeGeneration",
        "previousCheckpointDigest",
        "writerClaimDigest",
        "branchRef",
        "baseRevision",
        "headRevision",
        "workingStateDigest",
        "ownedPathsDigest",
        "createdAtUtc",
        "updatedAtUtc"
      ],
      "properties": {
        "repositoryId": {
          "$ref": "#/$defs/digest"
        },
        "taskId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "specRef": {
          "const": "docs/98.archive/completed/03.specs/0043-agent-harness-loop-lifecycle/spec.md"
        },
        "worktreeId": {
          "$ref": "#/$defs/digest"
        },
        "providerSurfaceId": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "providerSessionInstanceDigest": {
          "$ref": "#/$defs/digest"
        },
        "namespaceDigest": {
          "$ref": "#/$defs/digest"
        },
        "writerId": {
          "$ref": "#/$defs/digest"
        },
        "writeGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "previousCheckpointDigest": {
          "$ref": "#/$defs/digest"
        },
        "writerClaimDigest": {
          "$ref": "#/$defs/digest"
        },
        "branchRef": {
          "type": "string",
          "minLength": 12,
          "maxLength": 160,
          "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "baseRevision": {
          "$ref": "#/$defs/revision"
        },
        "headRevision": {
          "$ref": "#/$defs/revision"
        },
        "workingStateDigest": {
          "$ref": "#/$defs/digest"
        },
        "ownedPathsDigest": {
          "$ref": "#/$defs/digest"
        },
        "createdAtUtc": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAtUtc": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "repositoryObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "observed",
        "loopState"
      ],
      "properties": {
        "authority": {
          "const": "repository-wins"
        },
        "observed": {
          "const": true
        },
        "loopState": {
          "enum": [
            "ready",
            "running",
            "validating",
            "retry-assessment",
            "completed",
            "blocked",
            "escalated",
            "aborted"
          ]
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "providerId"
      ],
      "properties": {
        "roleId": {
          "$ref": "#/$defs/owner"
        },
        "providerId": {
          "enum": [
            "claude",
            "codex"
          ]
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptCount",
        "signatureRetryCount",
        "taskRecoveryCount"
      ],
      "properties": {
        "attemptCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "signatureRetryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "taskRecoveryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failureClass",
        "signatureDigest",
        "retryable"
      ],
      "properties": {
        "failureClass": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "signatureDigest": {
          "$ref": "#/$defs/digest"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "validationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRef",
        "result",
        "summary"
      ],
      "properties": {
        "evidenceRef": {
          "$ref": "#/$defs/evidenceRef"
        },
        "result": {
          "enum": [
            "PASS",
            "SKIP",
            "FAIL",
            "DEFER"
          ]
        },
        "summary": {
          "$ref": "#/$defs/summary"
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryStateWins",
        "conflictOrder",
        "rediscoveryRequired",
        "recomputeRemainingWork",
        "terminalReplayAllowed",
        "identityTupleRequired",
        "singleWriterRequired",
        "duplicateWriterAllowed",
        "duplicateResumeAllowed",
        "overwritePolicy",
        "acceptedIdentity"
      ],
      "properties": {
        "repositoryStateWins": {
          "type": "boolean"
        },
        "conflictOrder": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "observed-repository-state",
              "canonical-sdlc-or-domain-owner",
              "reviewed-durable-memory",
              "working-short-term",
              "provider-local-auxiliary"
            ]
          }
        },
        "rediscoveryRequired": {
          "type": "boolean"
        },
        "recomputeRemainingWork": {
          "type": "boolean"
        },
        "terminalReplayAllowed": {
          "type": "boolean"
        },
        "identityTupleRequired": {
          "const": true
        },
        "singleWriterRequired": {
          "const": true
        },
        "duplicateWriterAllowed": {
          "const": false
        },
        "duplicateResumeAllowed": {
          "const": false
        },
        "overwritePolicy": {
          "const": "compare-generation-and-previous-checkpoint-digest"
        },
        "acceptedIdentity": {
          "const": "exact-match-only"
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "credentialsStored",
        "tokensStored",
        "authPathsStored",
        "accountIdentifiersStored",
        "rawPromptStored",
        "transcriptStored",
        "providerBodyStored",
        "stdoutStored",
        "stderrStored",
        "shellHistoryStored",
        "environmentDumpStored",
        "privateDiagnosticsStored",
        "userConfigurationStored",
        "syntheticMarker"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "credentialsStored": {
          "type": "boolean"
        },
        "tokensStored": {
          "type": "boolean"
        },
        "authPathsStored": {
          "type": "boolean"
        },
        "accountIdentifiersStored": {
          "type": "boolean"
        },
        "rawPromptStored": {
          "type": "boolean"
        },
        "transcriptStored": {
          "type": "boolean"
        },
        "providerBodyStored": {
          "type": "boolean"
        },
        "stdoutStored": {
          "type": "boolean"
        },
        "stderrStored": {
          "type": "boolean"
        },
        "shellHistoryStored": {
          "type": "boolean"
        },
        "environmentDumpStored": {
          "type": "boolean"
        },
        "privateDiagnosticsStored": {
          "type": "boolean"
        },
        "userConfigurationStored": {
          "type": "boolean"
        },
        "syntheticMarker": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "[REDACTED-SYNTHETIC]",
            null
          ]
        }
      }
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "summary",
        "rawPromptRetained",
        "fullTranscriptRetained",
        "providerBodyRetained",
        "validationEvidenceRefs",
        "remainingWorkCount",
        "source",
        "replacement",
        "reviewStatus"
      ],
      "properties": {
        "state": {
          "const": "compacted"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "rawPromptRetained": {
          "type": "boolean"
        },
        "fullTranscriptRetained": {
          "type": "boolean"
        },
        "providerBodyRetained": {
          "type": "boolean"
        },
        "validationEvidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "remainingWorkCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "source": {
          "$ref": "#/$defs/compactionRecord"
        },
        "replacement": {
          "$ref": "#/$defs/compactionRecord"
        },
        "reviewStatus": {
          "const": "approved"
        }
      }
    },
    "compactionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "owner",
        "evidenceRefs"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "owner",
        "nextOwner",
        "resultSummary",
        "evidenceRefs",
        "limitations",
        "nextAction"
      ],
      "properties": {
        "state": {
          "enum": [
            "ready",
            "not-required"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:[-/][a-z0-9]+)*$"
        },
        "nextOwner": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:[-/][a-z0-9]+)*$"
        },
        "resultSummary": {
          "$ref": "#/$defs/summary"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "limitations": {
          "$ref": "#/$defs/summaryList"
        },
        "nextAction": {
          "$ref": "#/$defs/summary"
        }
      }
    },
    "promotionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "reviewer",
        "evidenceRef"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "approved",
            "not-applicable"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:[-/][a-z0-9]+)*$"
        },
        "evidenceRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/evidenceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetClass",
        "canonicalOwner",
        "evidenceRefs",
        "review",
        "redactionStatus",
        "repositoryReobserved",
        "directCanonicalWrite",
        "reobservationEvidenceClass"
      ],
      "properties": {
        "targetClass": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "working-short-term",
            "durable-long-term",
            null
          ]
        },
        "canonicalOwner": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:[-/][a-z0-9]+)*$"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "review": {
          "$ref": "#/$defs/promotionReview"
        },
        "redactionStatus": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "repositoryReobserved": {
          "type": "boolean"
        },
        "directCanonicalWrite": {
          "type": "boolean"
        },
        "reobservationEvidenceClass": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "repo-static",
            null
          ]
        }
      }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "refreshDueAtUtc",
        "observedRevision",
        "canonicalOwner",
        "evidenceRefs"
      ],
      "properties": {
        "status": {
          "const": "refreshed"
        },
        "basis": {
          "enum": [
            "task-resume",
            "canonical-owner-review",
            "domain-owner-review",
            "provider-reobservation"
          ]
        },
        "refreshDueAtUtc": {
          "$ref": "#/$defs/timestamp"
        },
        "observedRevision": {
          "$ref": "#/$defs/revision"
        },
        "canonicalOwner": {
          "$ref": "#/$defs/owner"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "expiry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "state",
        "disposition",
        "decisionOwner",
        "evidenceRefs"
      ],
      "properties": {
        "basis": {
          "enum": [
            "task-terminal",
            "owner-retention",
            "superseded-or-invalidated",
            "provider-retention"
          ]
        },
        "state": {
          "enum": [
            "active",
            "expired"
          ]
        },
        "disposition": {
          "enum": [
            "discard",
            "retain",
            "archive",
            "garbage-collect"
          ]
        },
        "decisionOwner": {
          "$ref": "#/$defs/owner"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "archiveGc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "disposition",
        "archivedAtUtc",
        "originalOwner",
        "currentOrReplacementOwner",
        "reviewStatus",
        "provenanceRefs"
      ],
      "properties": {
        "reason": {
          "$ref": "#/$defs/summary"
        },
        "disposition": {
          "enum": [
            "retain",
            "archive",
            "garbage-collect",
            "discard"
          ]
        },
        "archivedAtUtc": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "originalOwner": {
          "$ref": "#/$defs/owner"
        },
        "currentOrReplacementOwner": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:[-/][a-z0-9]+)*$"
        },
        "reviewStatus": {
          "const": "approved"
        },
        "provenanceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "repositoryWins",
        "winner",
        "resolutionEvidenceRefs"
      ],
      "properties": {
        "status": {
          "enum": [
            "no-conflict",
            "repository-won",
            "canonical-owner-won"
          ]
        },
        "repositoryWins": {
          "type": "boolean"
        },
        "winner": {
          "enum": [
            "repository-state",
            "canonical-document-owner",
            "canonical-domain-owner"
          ]
        },
        "resolutionEvidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "restrictedContextAllowed",
        "rawContextAllowed",
        "providerPayloadAllowed",
        "reviewStatus"
      ],
      "properties": {
        "classification": {
          "const": "non-sensitive-redacted"
        },
        "restrictedContextAllowed": {
          "const": false
        },
        "rawContextAllowed": {
          "const": false
        },
        "providerPayloadAllowed": {
          "const": false
        },
        "reviewStatus": {
          "const": "approved"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "canonicalDecisionOwner",
        "reviewStatus",
        "evidenceRefs"
      ],
      "properties": {
        "policy": {
          "enum": [
            "discard-at-task-terminal",
            "retain-under-canonical-owner",
            "archive-when-superseded-or-invalidated",
            "garbage-collect-under-provider-retention-after-repository-reobservation"
          ]
        },
        "canonicalDecisionOwner": {
          "$ref": "#/$defs/owner"
        },
        "reviewStatus": {
          "const": "approved"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    },
    "memoryHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentOwner",
        "nextOwner",
        "disposition",
        "reviewStatus",
        "evidenceRefs"
      ],
      "properties": {
        "currentOwner": {
          "$ref": "#/$defs/owner"
        },
        "nextOwner": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:[-/][a-z0-9]+)*$"
        },
        "disposition": {
          "enum": [
            "discard",
            "retain",
            "archive",
            "garbage-collect"
          ]
        },
        "reviewStatus": {
          "const": "approved"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    },
    "memoryLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classId",
        "authorityMode",
        "canonicalOwner",
        "sourceEvidenceRefs",
        "redactionStatus",
        "promotion",
        "refresh",
        "expiry",
        "archiveGc",
        "conflict",
        "sensitivity",
        "retention",
        "handoff"
      ],
      "properties": {
        "classId": {
          "enum": [
            "working-short-term",
            "durable-long-term",
            "domain-scoped",
            "provider-local-auxiliary"
          ]
        },
        "authorityMode": {
          "enum": [
            "temporary-context-only",
            "canonical-repository-record",
            "canonical-domain-record",
            "advisory-only"
          ]
        },
        "canonicalOwner": {
          "$ref": "#/$defs/owner"
        },
        "sourceEvidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "redactionStatus": {
          "const": "PASS"
        },
        "promotion": {
          "$ref": "#/$defs/promotion"
        },
        "refresh": {
          "$ref": "#/$defs/refresh"
        },
        "expiry": {
          "$ref": "#/$defs/expiry"
        },
        "archiveGc": {
          "$ref": "#/$defs/archiveGc"
        },
        "conflict": {
          "$ref": "#/$defs/conflict"
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        },
        "retention": {
          "$ref": "#/$defs/retention"
        },
        "handoff": {
          "$ref": "#/$defs/memoryHandoff"
        }
      }
    }
  }
}
