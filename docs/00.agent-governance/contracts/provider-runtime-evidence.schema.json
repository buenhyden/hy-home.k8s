{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider-runtime-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "contractVersion",
    "owner",
    "capabilityEvidenceOwner",
    "cutoff",
    "sourceLedger",
    "observationHistory",
    "providers",
    "mcpInventory",
    "canaryRecordContract",
    "canaryRecords",
    "routeIntegration"
  ],
  "properties": {
    "$schema": {
      "const": "./provider-runtime-evidence.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contractId": {
      "const": "provider-runtime-evidence"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "owner": {
      "const": "docs/98.archive/completed/03.specs/0042-provider-native-runtime-and-model-evidence/spec.md"
    },
    "capabilityEvidenceOwner": {
      "const": "docs/00.agent-governance/contracts/provider-runtime-evidence.json"
    },
    "cutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localTime",
        "utc",
        "timezone"
      ],
      "properties": {
        "localTime": {
          "const": "2026-07-10T10:00:00+09:00"
        },
        "utc": {
          "const": "2026-07-10T01:00:00Z"
        },
        "timezone": {
          "const": "Asia/Seoul"
        }
      }
    },
    "sourceLedger": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "observationHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observationHistory"
      }
    },
    "providers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "mcpInventory": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/mcpServer"
      }
    },
    "canaryRecordContract": {
      "$ref": "#/$defs/canaryRecordContract"
    },
    "canaryRecords": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/canaryRecord"
      }
    },
    "routeIntegration": {
      "$ref": "#/$defs/routeIntegration"
    }
  },
  "$defs": {
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "ABSENT",
        "DEFER"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "publisher",
        "url",
        "sourceDate",
        "publishedAtUtc",
        "dateBasis",
        "cutoffApplicability",
        "confidence",
        "claim"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "provider": {
          "enum": [
            "claude",
            "codex",
            "agency-agents"
          ]
        },
        "publisher": {
          "enum": [
            "Anthropic",
            "OpenAI",
            "GitHub"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "sourceDate": {
          "type": "string",
          "pattern": "^2026-[0-9]{2}-[0-9]{2}$"
        },
        "publishedAtUtc": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^2026-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "dateBasis": {
          "enum": [
            "release",
            "commit",
            "observed"
          ]
        },
        "cutoffApplicability": {
          "enum": [
            "cutoff-applicable",
            "current-only",
            "post-cutoff"
          ]
        },
        "confidence": {
          "enum": [
            "dated-primary",
            "current-primary"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observationHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "observationClass",
        "observedAt",
        "recordedAt",
        "readinessClaim",
        "providers",
        "claimBoundary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "observationClass": {
          "const": "prior-user-report"
        },
        "observedAt": {
          "$ref": "#/$defs/nullableString"
        },
        "recordedAt": {
          "type": "string",
          "pattern": "^2026-[0-9]{2}-[0-9]{2}$"
        },
        "readinessClaim": {
          "const": false
        },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claude",
            "codex"
          ],
          "properties": {
            "claude": {
              "$ref": "#/$defs/priorProviderObservation"
            },
            "codex": {
              "$ref": "#/$defs/priorProviderObservation"
            }
          }
        },
        "claimBoundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "priorProviderObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation",
        "version"
      ],
      "properties": {
        "installation": {
          "enum": [
            "present",
            "absent"
          ]
        },
        "version": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "trackedSurface",
        "projectPaths",
        "localObservation",
        "runtimeVerdicts",
        "evidenceLanes",
        "modelCandidates"
      ],
      "properties": {
        "id": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "trackedSurface": {
          "$ref": "#/$defs/trackedSurface"
        },
        "projectPaths": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/projectPath"
          }
        },
        "localObservation": {
          "$ref": "#/$defs/localObservation"
        },
        "runtimeVerdicts": {
          "$ref": "#/$defs/runtimeVerdicts"
        },
        "evidenceLanes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/evidenceLane"
          }
        },
        "modelCandidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/modelCandidate"
          }
        }
      }
    },
    "trackedSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pathRoot",
        "state",
        "presence",
        "evidenceClass",
        "claimBoundary"
      ],
      "properties": {
        "pathRoot": {
          "$ref": "#/$defs/repoPath"
        },
        "state": {
          "enum": [
            "current",
            "target-only"
          ]
        },
        "presence": {
          "enum": [
            "present",
            "absent"
          ]
        },
        "evidenceClass": {
          "const": "repo-static"
        },
        "claimBoundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projectPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "state"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "kind": {
          "enum": [
            "role-directory",
            "provider-adapter",
            "provider-shim",
            "tracked-settings"
          ]
        },
        "state": {
          "enum": [
            "current",
            "target-only",
            "absent"
          ]
        }
      }
    },
    "localObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation",
        "version",
        "verdict",
        "observedAt",
        "observationClass",
        "userReported",
        "readinessClaim",
        "evidence"
      ],
      "properties": {
        "installation": {
          "enum": [
            "present",
            "absent",
            "not-applicable"
          ]
        },
        "version": {
          "$ref": "#/$defs/nullableString"
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "observedAt": {
          "type": "string",
          "pattern": "^2026-[0-9]{2}-[0-9]{2}$"
        },
        "observationClass": {
          "enum": [
            "local-cli-version",
            "repo-static-local"
          ]
        },
        "userReported": {
          "type": "boolean"
        },
        "readinessClaim": {
          "const": false
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimeVerdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoStatic",
        "nativeDiscovery",
        "authenticatedRun"
      ],
      "properties": {
        "repoStatic": {
          "$ref": "#/$defs/verdict"
        },
        "nativeDiscovery": {
          "$ref": "#/$defs/verdict"
        },
        "authenticatedRun": {
          "$ref": "#/$defs/verdict"
        }
      }
    },
    "evidenceLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "verdict",
        "owner",
        "limitation",
        "retryTrigger",
        "crossLanePromotion"
      ],
      "properties": {
        "id": {
          "enum": [
            "repo-static",
            "native-discovery",
            "authenticated-run"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "$ref": "#/$defs/nullableString"
        },
        "retryTrigger": {
          "$ref": "#/$defs/nullableString"
        },
        "crossLanePromotion": {
          "const": false
        }
      }
    },
    "modelCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleClass",
        "candidate",
        "sourceIds",
        "configuredId",
        "observedId",
        "idResolution",
        "promotionState",
        "effort",
        "fallback",
        "gates"
      ],
      "properties": {
        "roleClass": {
          "enum": [
            "planning-supervisor",
            "worker-subagent"
          ]
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "configuredId": {
          "$ref": "#/$defs/nullableString"
        },
        "observedId": {
          "$ref": "#/$defs/nullableString"
        },
        "idResolution": {
          "enum": [
            "configured-only",
            "unresolved",
            "resolved"
          ]
        },
        "promotionState": {
          "const": "candidate-only"
        },
        "effort": {
          "$ref": "#/$defs/modelEffort"
        },
        "fallback": {
          "$ref": "#/$defs/modelFallback"
        },
        "gates": {
          "$ref": "#/$defs/modelGates"
        }
      }
    },
    "modelEffort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "configured",
        "observed",
        "support"
      ],
      "properties": {
        "candidate": {
          "$ref": "#/$defs/nullableString"
        },
        "configured": {
          "$ref": "#/$defs/nullableString"
        },
        "observed": {
          "$ref": "#/$defs/nullableString"
        },
        "support": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modelFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "configuredId",
        "observedId",
        "silentFallbackAllowed"
      ],
      "properties": {
        "policy": {
          "const": "fail-closed"
        },
        "configuredId": {
          "$ref": "#/$defs/nullableString"
        },
        "observedId": {
          "$ref": "#/$defs/nullableString"
        },
        "silentFallbackAllowed": {
          "type": "boolean"
        }
      }
    },
    "modelGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configParse",
        "runtimeResolution",
        "spec044Fitness"
      ],
      "properties": {
        "configParse": {
          "$ref": "#/$defs/verdict"
        },
        "runtimeResolution": {
          "$ref": "#/$defs/verdict"
        },
        "spec044Fitness": {
          "$ref": "#/$defs/verdict"
        }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "purpose",
        "transport",
        "trustBoundary",
        "credentialClass",
        "allowedRoles",
        "sensitivity",
        "networkRequired",
        "runtimeState"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "stdio",
            "http",
            "sse"
          ]
        },
        "trustBoundary": {
          "type": "string",
          "minLength": 1
        },
        "credentialClass": {
          "enum": [
            "none",
            "environment-reference",
            "provider-managed-auth"
          ]
        },
        "allowedRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "sensitivity": {
          "type": "string",
          "minLength": 1
        },
        "networkRequired": {
          "type": "boolean"
        },
        "runtimeState": {
          "$ref": "#/$defs/verdict"
        }
      }
    },
    "canaryRecordContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedVerdicts",
        "requiredEvidenceClasses",
        "redactionRequired",
        "syntheticTaskRequired",
        "mutationMode",
        "crossLanePromotionAllowed",
        "prohibitedDurableContent"
      ],
      "properties": {
        "allowedVerdicts": {
          "const": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "ABSENT",
            "DEFER"
          ]
        },
        "requiredEvidenceClasses": {
          "const": [
            "repo-static",
            "native-discovery",
            "authenticated-run"
          ]
        },
        "redactionRequired": {
          "const": true
        },
        "syntheticTaskRequired": {
          "const": true
        },
        "mutationMode": {
          "const": "no-mutation"
        },
        "crossLanePromotionAllowed": {
          "const": false
        },
        "prohibitedDurableContent": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "canaryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "providerId",
        "evidenceClass",
        "verdict",
        "synthetic",
        "mutationMode",
        "executionState",
        "configuredModelId",
        "observedModelId",
        "effort",
        "fallbackObserved",
        "allowedTools",
        "resultAssertion",
        "owner",
        "limitation",
        "retryTrigger",
        "redaction",
        "crossLanePromotion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "providerId": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "evidenceClass": {
          "enum": [
            "repo-static",
            "native-discovery",
            "authenticated-run"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "synthetic": {
          "const": true
        },
        "mutationMode": {
          "const": "no-mutation"
        },
        "executionState": {
          "enum": [
            "synthetic-static-observation",
            "not-executed"
          ]
        },
        "configuredModelId": {
          "$ref": "#/$defs/nullableString"
        },
        "observedModelId": {
          "$ref": "#/$defs/nullableString"
        },
        "effort": {
          "$ref": "#/$defs/nullableString"
        },
        "fallbackObserved": {
          "type": "boolean"
        },
        "allowedTools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "resultAssertion": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "$ref": "#/$defs/nullableString"
        },
        "retryTrigger": {
          "$ref": "#/$defs/nullableString"
        },
        "redaction": {
          "$ref": "#/$defs/redaction"
        },
        "crossLanePromotion": {
          "const": false
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rawPromptStored",
        "providerBodyStored",
        "credentialsStored",
        "authPathsStored"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "rawPromptStored": {
          "const": false
        },
        "providerBodyStored": {
          "const": false
        },
        "credentialsStored": {
          "const": false
        },
        "authPathsStored": {
          "const": false
        }
      }
    },
    "routeIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validatorId",
        "argv",
        "focusedValidators",
        "surfaces",
        "excludedSurfaces"
      ],
      "properties": {
        "validatorId": {
          "const": "agent-provider-evidence"
        },
        "argv": {
          "const": [
            "python3",
            "scripts/validate-agent-provider-evidence.py",
            "--root",
            "."
          ]
        },
        "focusedValidators": {
          "const": [
            [
              "python3",
              "scripts/validate-agent-provider-config.py",
              "--root",
              "."
            ],
            [
              "python3",
              "scripts/validate-agent-provider-canaries.py",
              "--root",
              "."
            ]
          ]
        },
        "surfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludedSurfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
