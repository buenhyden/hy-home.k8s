root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Markdown keeps the repository-wide setting: the `trailing-whitespace`
# pre-commit hook strips it everywhere, no tracked file uses a trailing-space
# hard break, and an exemption here only lets an editor add what the hook then
# removes.
