root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Markdown keeps the repository-wide editor hint: the `trailing-whitespace`
# pre-commit hook strips it from selected active paths, while frozen terminal
# Archive payloads remain excluded to preserve sealed bytes. No selected
# current file uses a trailing-space hard break, so an editor exemption would
# only add whitespace that the hook then removes.
