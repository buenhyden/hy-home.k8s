{
  "$schema": "./contracts/agent-registry.schema.json",
  "schema_version": 1,
  "registry_id": "hy-home.k8s/agents",
  "providers": [
    {"id": "claude", "gateway": "CLAUDE.md", "projection_root": ".claude/agents"},
    {"id": "codex", "gateway": "AGENTS.md", "projection_root": ".codex/agents"}
  ],
  "permission_classes": [
    {"id": "read-only-evidence", "allows_mutation": false, "allows_delegation": false, "external_writes_require_approval": true},
    {"id": "scoped-authoring", "allows_mutation": true, "allows_delegation": false, "external_writes_require_approval": true},
    {"id": "orchestration", "allows_mutation": false, "allows_delegation": true, "external_writes_require_approval": true}
  ],
  "skills": [
    {"id": "deployment-strategies", "path": ".agents/skills/deployment-strategies/skill.md"},
    {"id": "docs-stage-conformance", "path": ".agents/skills/docs-stage-conformance/skill.md"},
    {"id": "docs-stage-routing", "path": ".agents/skills/docs-stage-routing/skill.md"},
    {"id": "execution-plan", "path": ".agents/skills/execution-plan/skill.md"},
    {"id": "gitops-workflow", "path": ".agents/skills/gitops-workflow/skill.md"},
    {"id": "incident-postmortem", "path": ".agents/skills/incident-postmortem/skill.md"},
    {"id": "k8s-security-audit", "path": ".agents/skills/k8s-security-audit/skill.md"},
    {"id": "k8s-validate", "path": ".agents/skills/k8s-validate/skill.md"},
    {"id": "knowledge-map", "path": ".agents/skills/knowledge-map/skill.md"},
    {"id": "ops-runbook", "path": ".agents/skills/ops-runbook/skill.md"},
    {"id": "rca-methodology", "path": ".agents/skills/rca-methodology/skill.md"},
    {"id": "requirements-to-design", "path": ".agents/skills/requirements-to-design/skill.md"},
    {"id": "risk-report", "path": ".agents/skills/risk-report/skill.md"},
    {"id": "task-breakdown", "path": ".agents/skills/task-breakdown/skill.md"},
    {"id": "vulnerability-patterns", "path": ".agents/skills/vulnerability-patterns/skill.md"},
    {"id": "workspace-harness-audit", "path": ".agents/skills/workspace-harness-audit/skill.md"}
  ],
  "roles": [
    {
      "id": "supervisor",
      "responsibility": "Route bounded work, preserve approval and ownership boundaries, and reconcile final evidence.",
      "permission_class": "orchestration",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#top",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["execution-plan", "risk-report", "task-breakdown"],
      "handoff_to": ["code-reviewer", "doc-writer", "k8s-implementer", "quality-engineer", "security-auditor"],
      "projections": {"neutral": ".agents/agents/supervisor.md", "claude": ".claude/agents/supervisor.md", "codex": ".codex/agents/supervisor.toml"}
    },
    {
      "id": "code-reviewer",
      "responsibility": "Review repository changes for correctness, maintainability, regression risk, and policy alignment.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#worker",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["risk-report"],
      "handoff_to": ["security-auditor", "supervisor"],
      "projections": {"neutral": ".agents/agents/code-reviewer.md", "claude": ".claude/agents/code-reviewer.md", "codex": ".codex/agents/code-reviewer.toml"}
    },
    {
      "id": "doc-writer",
      "responsibility": "Author governed documentation at the canonical SDLC or common-document owner.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#worker",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["docs-stage-conformance", "docs-stage-routing", "requirements-to-design"],
      "handoff_to": ["docs-researcher", "supervisor", "wiki-curator"],
      "projections": {"neutral": ".agents/agents/doc-writer.md", "claude": ".claude/agents/doc-writer.md", "codex": ".codex/agents/doc-writer.toml"}
    },
    {
      "id": "gitops-reviewer",
      "responsibility": "Review GitOps manifests and reconciliation behavior without assuming mutation authority.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#worker",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["gitops-workflow", "k8s-validate"],
      "handoff_to": ["k8s-implementer", "security-auditor", "supervisor"],
      "projections": {"neutral": ".agents/agents/gitops-reviewer.md", "claude": ".claude/agents/gitops-reviewer.md", "codex": ".codex/agents/gitops-reviewer.toml"}
    },
    {
      "id": "incident-responder",
      "responsibility": "Triage incidents, bound impact, and produce evidence-based response and corrective-action guidance.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#top",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["incident-postmortem", "rca-methodology"],
      "handoff_to": ["security-auditor", "k8s-implementer", "supervisor"],
      "projections": {"neutral": ".agents/agents/incident-responder.md", "claude": ".claude/agents/incident-responder.md", "codex": ".codex/agents/incident-responder.toml"}
    },
    {
      "id": "k8s-implementer",
      "responsibility": "Implement explicitly scoped Kubernetes and GitOps changes and validate the affected reconciliation surface.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#worker",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["deployment-strategies", "gitops-workflow", "k8s-validate"],
      "handoff_to": ["gitops-reviewer", "security-auditor", "supervisor"],
      "projections": {"neutral": ".agents/agents/k8s-implementer.md", "claude": ".claude/agents/k8s-implementer.md", "codex": ".codex/agents/k8s-implementer.toml"}
    },
    {
      "id": "network-reviewer",
      "responsibility": "Review cluster networking, ingress, DNS, policy, and isolation behavior from repository evidence.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#worker",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["k8s-security-audit", "risk-report"],
      "handoff_to": ["security-auditor", "gitops-reviewer", "supervisor"],
      "projections": {"neutral": ".agents/agents/network-reviewer.md", "claude": ".claude/agents/network-reviewer.md", "codex": ".codex/agents/network-reviewer.toml"}
    },
    {
      "id": "observability-reviewer",
      "responsibility": "Review metrics, logs, alerts, dashboards, and operational observability coverage.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#worker",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["ops-runbook", "risk-report"],
      "handoff_to": ["gitops-reviewer", "security-auditor", "supervisor"],
      "projections": {"neutral": ".agents/agents/observability-reviewer.md", "claude": ".claude/agents/observability-reviewer.md", "codex": ".codex/agents/observability-reviewer.toml"}
    },
    {
      "id": "security-auditor",
      "responsibility": "Audit repository changes for secret exposure, privilege escalation, isolation failure, and policy violations.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#top",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["k8s-security-audit", "vulnerability-patterns"],
      "handoff_to": ["k8s-implementer", "supervisor"],
      "projections": {"neutral": ".agents/agents/security-auditor.md", "claude": ".claude/agents/security-auditor.md", "codex": ".codex/agents/security-auditor.toml"}
    },
    {
      "id": "wiki-curator",
      "responsibility": "Maintain knowledge navigation and canonical links without creating duplicate policy authority.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#worker",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["docs-stage-conformance", "knowledge-map"],
      "handoff_to": ["doc-writer", "supervisor"],
      "projections": {"neutral": ".agents/agents/wiki-curator.md", "claude": ".claude/agents/wiki-curator.md", "codex": ".codex/agents/wiki-curator.toml"}
    },
    {
      "id": "docs-researcher",
      "responsibility": "Collect and classify source evidence for documentation without claiming policy authority.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#worker",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["docs-stage-routing", "knowledge-map"],
      "handoff_to": ["doc-writer", "supervisor"],
      "projections": {"neutral": ".agents/agents/docs-researcher.md", "claude": ".claude/agents/docs-researcher.md", "codex": ".codex/agents/docs-researcher.toml"}
    },
    {
      "id": "quality-engineer",
      "responsibility": "Design and run bounded repository validation and report reproducible quality evidence.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": "docs/00.agent-governance/policies/model-selection.md#worker",
      "supported_providers": ["claude", "codex"],
      "skill_refs": ["k8s-validate", "workspace-harness-audit"],
      "handoff_to": ["code-reviewer", "security-auditor", "supervisor"],
      "projections": {"neutral": ".agents/agents/quality-engineer.md", "claude": ".claude/agents/quality-engineer.md", "codex": ".codex/agents/quality-engineer.toml"}
    }
  ]
}
