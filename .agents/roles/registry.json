{
  "$schema": "./registry.schema.json",
  "schema_version": 2,
  "registry_id": "hy-home.k8s/agents",
  "providers": [
    {
      "id": "claude",
      "gateway": "CLAUDE.md",
      "projection_root": ".claude/agents",
      "bindings": ".claude/bindings.json"
    },
    {
      "id": "codex",
      "gateway": "AGENTS.md",
      "projection_root": ".codex/agents",
      "bindings": ".codex/bindings.json"
    }
  ],
  "permission_classes": [
    {
      "id": "read-only-evidence",
      "allows_mutation": false,
      "allows_delegation": false
    },
    {
      "id": "read-only-research",
      "allows_mutation": false,
      "allows_delegation": false
    },
    {
      "id": "scoped-authoring",
      "allows_mutation": true,
      "allows_delegation": false
    },
    {
      "id": "orchestration",
      "allows_mutation": false,
      "allows_delegation": true
    }
  ],
  "skills": [
    {
      "id": "deployment-strategies",
      "path": ".agents/skills/deployment-strategies/SKILL.md"
    },
    {
      "id": "docs-stage-conformance",
      "path": ".agents/skills/docs-stage-conformance/SKILL.md"
    },
    {
      "id": "docs-stage-routing",
      "path": ".agents/skills/docs-stage-routing/SKILL.md"
    },
    {
      "id": "execution-plan",
      "path": ".agents/skills/execution-plan/SKILL.md"
    },
    {
      "id": "external-service-contract-audit",
      "path": ".agents/skills/external-service-contract-audit/SKILL.md"
    },
    {
      "id": "gitops-workflow",
      "path": ".agents/skills/gitops-workflow/SKILL.md"
    },
    {
      "id": "incident-postmortem",
      "path": ".agents/skills/incident-postmortem/SKILL.md"
    },
    {
      "id": "k8s-security-audit",
      "path": ".agents/skills/k8s-security-audit/SKILL.md"
    },
    {
      "id": "k8s-validate",
      "path": ".agents/skills/k8s-validate/SKILL.md"
    },
    {
      "id": "knowledge-map",
      "path": ".agents/skills/knowledge-map/SKILL.md"
    },
    {
      "id": "ops-runbook",
      "path": ".agents/skills/ops-runbook/SKILL.md"
    },
    {
      "id": "rca-methodology",
      "path": ".agents/skills/rca-methodology/SKILL.md"
    },
    {
      "id": "requirements-to-design",
      "path": ".agents/skills/requirements-to-design/SKILL.md"
    },
    {
      "id": "risk-report",
      "path": ".agents/skills/risk-report/SKILL.md"
    },
    {
      "id": "task-breakdown",
      "path": ".agents/skills/task-breakdown/SKILL.md"
    },
    {
      "id": "vulnerability-patterns",
      "path": ".agents/skills/vulnerability-patterns/SKILL.md"
    },
    {
      "id": "workspace-harness-audit",
      "path": ".agents/skills/workspace-harness-audit/SKILL.md"
    }
  ],
  "roles": [
    {
      "id": "supervisor",
      "responsibility": "Route bounded work, preserve approval and ownership boundaries, and reconcile final evidence.",
      "permission_class": "orchestration",
      "capability_tier_ref": ".agents/governance/model-selection.md#top",
      "skill_refs": [
        "execution-plan",
        "risk-report",
        "task-breakdown"
      ],
      "handoff_to": [
        "agent-evaluator",
        "architect",
        "ci-workflow-engineer",
        "code-reviewer",
        "doc-writer",
        "docs-researcher",
        "gitops-reviewer",
        "governance-steward",
        "incident-responder",
        "k8s-implementer",
        "network-reviewer",
        "observability-reviewer",
        "quality-engineer",
        "repo-tooling-engineer",
        "security-auditor",
        "wiki-curator"
      ]
    },
    {
      "id": "code-reviewer",
      "responsibility": "Review repository changes for correctness, maintainability, regression risk, and policy alignment.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [
        "risk-report"
      ],
      "handoff_to": [
        "security-auditor",
        "supervisor"
      ]
    },
    {
      "id": "doc-writer",
      "responsibility": "Author governed documentation at the canonical SDLC or common-document owner.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [
        "docs-stage-conformance",
        "docs-stage-routing",
        "ops-runbook",
        "requirements-to-design"
      ],
      "handoff_to": [
        "architect",
        "docs-researcher",
        "supervisor",
        "wiki-curator"
      ]
    },
    {
      "id": "gitops-reviewer",
      "responsibility": "Review GitOps manifests and reconciliation behavior without assuming mutation authority.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [
        "gitops-workflow",
        "k8s-validate",
        "external-service-contract-audit"
      ],
      "handoff_to": [
        "k8s-implementer",
        "security-auditor",
        "supervisor"
      ]
    },
    {
      "id": "incident-responder",
      "responsibility": "Triage incidents, bound impact, and produce evidence-based response and corrective-action guidance.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": ".agents/governance/model-selection.md#top",
      "skill_refs": [
        "incident-postmortem",
        "rca-methodology"
      ],
      "handoff_to": [
        "security-auditor",
        "k8s-implementer",
        "supervisor"
      ]
    },
    {
      "id": "k8s-implementer",
      "responsibility": "Implement explicitly scoped Kubernetes and GitOps changes and validate the affected reconciliation surface.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [
        "deployment-strategies",
        "gitops-workflow",
        "k8s-validate",
        "external-service-contract-audit"
      ],
      "handoff_to": [
        "gitops-reviewer",
        "security-auditor",
        "supervisor"
      ]
    },
    {
      "id": "network-reviewer",
      "responsibility": "Review cluster networking, ingress, DNS, policy, and isolation behavior from repository evidence.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [
        "risk-report"
      ],
      "handoff_to": [
        "security-auditor",
        "gitops-reviewer",
        "supervisor"
      ]
    },
    {
      "id": "observability-reviewer",
      "responsibility": "Review metrics, logs, alerts, dashboards, and operational observability coverage.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [
        "risk-report"
      ],
      "handoff_to": [
        "gitops-reviewer",
        "security-auditor",
        "supervisor"
      ]
    },
    {
      "id": "security-auditor",
      "responsibility": "Audit repository changes for secret exposure, privilege escalation, isolation failure, and policy violations.",
      "permission_class": "read-only-evidence",
      "capability_tier_ref": ".agents/governance/model-selection.md#top",
      "skill_refs": [
        "k8s-security-audit",
        "vulnerability-patterns"
      ],
      "handoff_to": [
        "k8s-implementer",
        "network-reviewer",
        "supervisor"
      ]
    },
    {
      "id": "wiki-curator",
      "responsibility": "Maintain knowledge navigation and canonical links without creating duplicate policy authority.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [
        "docs-stage-conformance",
        "knowledge-map"
      ],
      "handoff_to": [
        "doc-writer",
        "supervisor"
      ]
    },
    {
      "id": "docs-researcher",
      "responsibility": "Collect and classify source evidence for documentation without claiming policy authority.",
      "permission_class": "read-only-research",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [
        "docs-stage-routing",
        "knowledge-map"
      ],
      "handoff_to": [
        "doc-writer",
        "supervisor"
      ]
    },
    {
      "id": "quality-engineer",
      "responsibility": "Design and run bounded repository validation and report reproducible quality evidence.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [
        "k8s-validate",
        "workspace-harness-audit"
      ],
      "handoff_to": [
        "code-reviewer",
        "security-auditor",
        "supervisor"
      ]
    },
    {
      "id": "architect",
      "responsibility": "Own structural decisions and architecture descriptions, and trace them to requirements and the owning Spec.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": ".agents/governance/model-selection.md#top",
      "skill_refs": [
        "requirements-to-design",
        "docs-stage-routing"
      ],
      "handoff_to": [
        "doc-writer",
        "k8s-implementer",
        "security-auditor",
        "supervisor"
      ]
    },
    {
      "id": "governance-steward",
      "responsibility": "Maintain the neutral agent registry, role bodies, skills, and provider projections without widening its own authority.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": ".agents/governance/model-selection.md#top",
      "skill_refs": [
        "workspace-harness-audit",
        "knowledge-map"
      ],
      "handoff_to": [
        "agent-evaluator",
        "quality-engineer",
        "supervisor",
        "wiki-curator"
      ]
    },
    {
      "id": "ci-workflow-engineer",
      "responsibility": "Implement scoped hosted-surface changes under .github/ and keep workflow permissions, triggers, and action identities least-privilege.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [
        "risk-report"
      ],
      "handoff_to": [
        "quality-engineer",
        "repo-tooling-engineer",
        "security-auditor",
        "supervisor"
      ]
    },
    {
      "id": "repo-tooling-engineer",
      "responsibility": "Implement repository tooling that is not a registered validation-lane member, and keep its failures identified and actionable.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [
        "workspace-harness-audit",
        "docs-stage-conformance"
      ],
      "handoff_to": [
        "agent-evaluator",
        "ci-workflow-engineer",
        "quality-engineer",
        "security-auditor",
        "supervisor"
      ]
    },
    {
      "id": "agent-evaluator",
      "responsibility": "Design and run agent evaluation cases and report scored evidence and improvement findings without editing role or skill definitions.",
      "permission_class": "scoped-authoring",
      "capability_tier_ref": ".agents/governance/model-selection.md#worker",
      "skill_refs": [],
      "handoff_to": [
        "governance-steward",
        "quality-engineer",
        "supervisor"
      ]
    }
  ]
}
