{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.k8s/schemas/agent-registry.schema.json",
  "title": "Provider-neutral agent registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "registry_id",
    "providers",
    "permission_classes",
    "skills",
    "roles"
  ],
  "properties": {
    "$schema": {
      "const": "./registry.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "registry_id": {
      "const": "hy-home.k8s/agents"
    },
    "providers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/claudeProvider"
        },
        {
          "$ref": "#/$defs/codexProvider"
        }
      ],
      "items": false
    },
    "permission_classes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/permissionClass"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/role"
      }
    }
  },
  "$defs": {
    "claudeProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gateway",
        "projection_root",
        "capability_models",
        "permission_scopes"
      ],
      "properties": {
        "id": {
          "const": "claude"
        },
        "gateway": {
          "const": "CLAUDE.md"
        },
        "projection_root": {
          "const": ".claude/agents"
        },
        "capability_models": {
          "$ref": "#/$defs/capabilityModelBinding"
        },
        "permission_scopes": {
          "$ref": "#/$defs/claudePermissionScopes"
        }
      }
    },
    "codexProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gateway",
        "projection_root",
        "capability_models",
        "permission_scopes"
      ],
      "properties": {
        "id": {
          "const": "codex"
        },
        "gateway": {
          "const": "AGENTS.md"
        },
        "projection_root": {
          "const": ".codex/agents"
        },
        "capability_models": {
          "$ref": "#/$defs/capabilityModelBinding"
        },
        "permission_scopes": {
          "$ref": "#/$defs/codexPermissionScopes"
        }
      }
    },
    "permissionClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "allows_mutation",
        "allows_delegation",
        "external_writes_require_approval"
      ],
      "properties": {
        "id": {
          "enum": [
            "read-only-evidence",
            "scoped-authoring",
            "orchestration"
          ]
        },
        "allows_mutation": {
          "type": "boolean"
        },
        "allows_delegation": {
          "type": "boolean"
        },
        "external_writes_require_approval": {
          "const": true
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "path": {
          "type": "string",
          "pattern": "^\\.agents/skills/[a-z0-9-]+/SKILL\\.md$",
          "maxLength": 160
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "responsibility",
        "permission_class",
        "capability_tier_ref",
        "supported_providers",
        "skill_refs",
        "handoff_to",
        "projections"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "responsibility": {
          "type": "string",
          "minLength": 16,
          "maxLength": 360
        },
        "permission_class": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "capability_tier_ref": {
          "type": "string",
          "pattern": "^\\.agents/governance/model-selection\\.md#(?:top|worker)$",
          "maxLength": 160
        },
        "supported_providers": {
          "type": "array",
          "prefixItems": [
            {
              "const": "claude"
            },
            {
              "const": "codex"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "skill_refs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "handoff_to": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "projections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "neutral",
            "claude",
            "codex"
          ],
          "properties": {
            "neutral": {
              "type": "string",
              "pattern": "^\\.agents/roles/[a-z0-9-]+\\.md$"
            },
            "claude": {
              "type": "string",
              "pattern": "^\\.claude/agents/[a-z0-9-]+\\.md$"
            },
            "codex": {
              "type": "string",
              "pattern": "^\\.codex/agents/[a-z0-9-]+\\.toml$"
            }
          }
        },
        "native_scope_override": {
          "$ref": "#/$defs/nativeScopeOverride"
        }
      }
    },
    "nativeModelIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,159}$"
    },
    "capabilityModelBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "worker"
      ],
      "properties": {
        "top": {
          "$ref": "#/$defs/nativeModelIdentifier"
        },
        "worker": {
          "$ref": "#/$defs/nativeModelIdentifier"
        }
      }
    },
    "codexSandboxScope": {
      "type": "string",
      "enum": [
        "read-only",
        "workspace-write"
      ]
    },
    "codexPermissionScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read-only-evidence",
        "orchestration",
        "scoped-authoring"
      ],
      "properties": {
        "read-only-evidence": {
          "$ref": "#/$defs/codexSandboxScope"
        },
        "orchestration": {
          "$ref": "#/$defs/codexSandboxScope"
        },
        "scoped-authoring": {
          "$ref": "#/$defs/codexSandboxScope"
        }
      }
    },
    "claudeToolScope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z]{1,23}$"
      }
    },
    "claudePermissionScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read-only-evidence",
        "scoped-authoring",
        "orchestration"
      ],
      "properties": {
        "read-only-evidence": {
          "$ref": "#/$defs/claudeToolScope"
        },
        "scoped-authoring": {
          "$ref": "#/$defs/claudeToolScope"
        },
        "orchestration": {
          "$ref": "#/$defs/claudeToolScope"
        }
      }
    },
    "nativeScopeOverride": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "claude": {
          "$ref": "#/$defs/claudeToolScope"
        },
        "codex": {
          "$ref": "#/$defs/codexSandboxScope"
        }
      }
    }
  }
}
