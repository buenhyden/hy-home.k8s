{
  "customInstructions": "Enforce Template-First document routing through docs/99.templates/support/template-routing.md, then read the matching template under docs/99.templates/templates/. Implement explicit QA and CI/static validation phases before considering any implementation complete. MUST utilize workspace structured directories. Consult docs/00.agent-governance/memory/.",
  "permissions": {
    "allow": [
      "Bash(git status --short)",
      "Bash(git diff --check)",
      "Bash(git diff --cached --check)",
      "Bash(git diff --name-only)",
      "Bash(git diff --cached --name-only)",
      "Bash(git rev-parse HEAD)",
      "Bash(git ls-files)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(cat .env:*)",
      "Bash(cat .env.*:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(vault kv get:*)",
      "Bash(vault read:*)",
      "Bash(vault token lookup:*)",
      "Bash(kubectl get secret:*)",
      "Bash(kubectl get secrets:*)",
      "Bash(kubectl describe secret:*)",
      "Bash(kubectl describe secrets:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh workflow run:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl label:*)",
      "Bash(kubectl annotate:*)",
      "Bash(kubectl set:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(kubectl rollout undo:*)",
      "Bash(kubectl port-forward:*)",
      "Bash(kubectl drain:*)",
      "Bash(kubectl cordon:*)",
      "Bash(kubectl uncordon:*)",
      "Bash(kubectl taint:*)",
      "Bash(argocd app sync:*)",
      "Bash(argocd app set:*)",
      "Bash(argocd app patch:*)",
      "Bash(argocd app delete:*)",
      "Bash(argocd app create:*)",
      "Bash(argocd app unset:*)",
      "Bash(argocd app terminate-op:*)",
      "Bash(vault kv put:*)",
      "Bash(vault kv patch:*)",
      "Bash(vault write:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(git branch -D:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --mirror:*)",
      "Bash(rm -rf:*)",
      "Bash(k3d cluster delete:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HY_HOME_K8S_HOOK_PROVIDER=claude bash $CLAUDE_PROJECT_DIR/docs/00.agent-governance/hooks/session-start.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "HY_HOME_K8S_HOOK_PROVIDER=claude bash $CLAUDE_PROJECT_DIR/docs/00.agent-governance/hooks/k8s-pre-edit.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i HOME=\"$HOME\" LANG=C.UTF-8 LC_ALL=C.UTF-8 PATH=/usr/bin:/bin CLAUDE_PROJECT_DIR=\"$CLAUDE_PROJECT_DIR\" HY_HOME_K8S_HOOK_PROVIDER=claude /usr/bin/bash --noprofile --norc \"$CLAUDE_PROJECT_DIR/docs/00.agent-governance/hooks/post-validate.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HY_HOME_K8S_HOOK_PROVIDER=claude bash $CLAUDE_PROJECT_DIR/docs/00.agent-governance/hooks/lifecycle-guard.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HY_HOME_K8S_HOOK_PROVIDER=claude bash $CLAUDE_PROJECT_DIR/docs/00.agent-governance/hooks/lifecycle-guard.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "HY_HOME_K8S_HOOK_PROVIDER=claude bash $CLAUDE_PROJECT_DIR/docs/00.agent-governance/hooks/lifecycle-guard.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
