{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(git status --short)",
      "Bash(git diff --check)",
      "Bash(git diff --cached --check)",
      "Bash(git diff --name-only)",
      "Bash(git diff --cached --name-only)",
      "Bash(git rev-parse HEAD)",
      "Bash(git ls-files)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(cat .env:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(vault kv get:*)",
      "Bash(vault read:*)",
      "Bash(vault token lookup:*)",
      "Bash(kubectl get secret:*)",
      "Bash(kubectl get secrets:*)",
      "Bash(kubectl describe secret:*)",
      "Bash(kubectl describe secrets:*)",
      "Bash(gh release create:*)",
      "Bash(gh workflow run:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl label:*)",
      "Bash(kubectl annotate:*)",
      "Bash(kubectl set:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(kubectl rollout undo:*)",
      "Bash(kubectl port-forward:*)",
      "Bash(kubectl drain:*)",
      "Bash(kubectl cordon:*)",
      "Bash(kubectl uncordon:*)",
      "Bash(kubectl taint:*)",
      "Bash(argocd app sync:*)",
      "Bash(argocd app set:*)",
      "Bash(argocd app patch:*)",
      "Bash(argocd app delete:*)",
      "Bash(argocd app create:*)",
      "Bash(argocd app unset:*)",
      "Bash(argocd app terminate-op:*)",
      "Bash(vault kv put:*)",
      "Bash(vault kv patch:*)",
      "Bash(vault write:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(git branch -D:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --mirror:*)",
      "Bash(rm -rf:*)",
      "Bash(k3d cluster delete:*)",
      "Read(./secrets/**)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)",
      "Read(~/.vault-token)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(//proc/*/environ)",
      "Bash(gh auth token*)",
      "Bash(vault print token*)",
      "Bash(kubectl *--raw*)",
      "Bash(k3d kubeconfig *)",
      "Bash(kubectl * secret*)",
      "Bash(helm get values*)",
      "Bash(export -p*)",
      "Bash(declare -x*)",
      "Bash(declare -p*)",
      "Bash(* secrets/*)",
      "Bash(* ./secrets/*)",
      "Bash(* .env*)",
      "Bash(*/.env*)",
      "Bash(*/.kube/*)",
      "Bash(*/.ssh/*)",
      "Bash(*.vault-token*)",
      "Bash(*/.config/gh/*)",
      "Bash(*.credentials.json*)",
      "Bash(*/.codex/auth.json*)",
      "Bash(*/environ*)",
      "Bash(kubectl * delete *)",
      "Bash(kubectl * apply *)",
      "Bash(kubectl * create *)",
      "Bash(kubectl * replace *)",
      "Bash(kubectl * exec *)",
      "Bash(kubectl * patch *)",
      "Bash(kubectl * edit *)",
      "Bash(kubectl * label *)",
      "Bash(kubectl * annotate *)",
      "Bash(kubectl * set *)",
      "Bash(kubectl * scale *)",
      "Bash(kubectl * rollout restart *)",
      "Bash(kubectl * rollout undo *)",
      "Bash(kubectl * port-forward *)",
      "Bash(kubectl * drain *)",
      "Bash(kubectl * cordon *)",
      "Bash(kubectl * uncordon *)",
      "Bash(kubectl * taint *)",
      "Bash(kubectl * cp *)",
      "Bash(kubectl * debug *)",
      "Bash(kubectl * attach *)",
      "Bash(kubectl * run *)",
      "Bash(kubectl * proxy *)",
      "Bash(kubectl * proxy)",
      "Bash(kubectl cp *)",
      "Bash(kubectl debug *)",
      "Bash(kubectl attach *)",
      "Bash(kubectl run *)",
      "Bash(kubectl proxy *)",
      "Bash(helm install *)",
      "Bash(helm * install *)",
      "Bash(helm upgrade *)",
      "Bash(helm * upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(helm * uninstall *)",
      "Bash(helm delete *)",
      "Bash(helm * delete *)",
      "Bash(helm rollback *)",
      "Bash(helm * rollback *)",
      "Bash(vault kv delete*)",
      "Bash(vault kv destroy*)",
      "Bash(vault kv metadata delete*)",
      "Bash(vault delete*)",
      "Bash(vault secrets disable*)",
      "Bash(vault policy write*)",
      "Bash(vault token create*)",
      "Bash(vault login*)",
      "Bash(argocd * app sync*)",
      "Bash(argocd * app delete*)",
      "Bash(argocd app rollback*)",
      "Bash(argocd * app rollback*)",
      "Bash(argocd account generate-token*)",
      "Bash(argocd cluster rm*)",
      "Bash(k3d * delete*)",
      "Bash(k3d cluster stop*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/k8s-pre-edit.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
